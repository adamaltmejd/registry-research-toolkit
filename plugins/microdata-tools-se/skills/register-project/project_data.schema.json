{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project_data.json",
  "type": "object",
  "description": "The top-level `project_data.json` document.",
  "required": [
    "schema_version",
    "reg_meta_version",
    "name",
    "sources"
  ],
  "properties": {
    "extract_format": {
      "$ref": "#/$defs/ProjectExtractFormat",
      "description": "The extract file format. Absent means the order authoring default, `dta`, which\nthe order file resolves; it is never inserted here. An explicit `null` is\n`invalid_field_type`."
    },
    "name": {
      "type": "string"
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProjectPanel"
      }
    },
    "reg_meta_version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProjectSource"
      }
    },
    "window": {
      "$ref": "#/$defs/ProjectStudyWindow"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ProjectBinding": {
      "type": "object",
      "description": "One variable to extract.",
      "required": [
        "variable",
        "type"
      ],
      "properties": {
        "classification": {
          "type": [
            "string",
            "null"
          ],
          "description": "A classification version's public id `class/<family>/<version>`.",
          "pattern": "^class/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$"
        },
        "date_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "datetime_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "follow_successor": {
          "type": "boolean",
          "description": "Follow the variable's continues successors after it ends; absent means false.",
          "default": false
        },
        "id_subtype": {
          "oneOf": [
            {
              "$ref": "#/$defs/ProjectIdSubtype"
            },
            {
              "type": "null"
            }
          ]
        },
        "numeric_subtype": {
          "oneOf": [
            {
              "$ref": "#/$defs/ProjectNumericSubtype"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "$ref": "#/$defs/ProjectColumnType"
        },
        "variable": {
          "type": "string",
          "description": "The binding FQID `<provider>/<register>/<slug>`."
        }
      },
      "additionalProperties": false
    },
    "ProjectColumnType": {
      "type": "string",
      "enum": [
        "id",
        "categorical",
        "numeric",
        "date",
        "datetime",
        "opaque"
      ]
    },
    "ProjectExtractFormat": {
      "type": "string",
      "enum": [
        "dta",
        "parquet",
        "csv"
      ]
    },
    "ProjectIdSubtype": {
      "type": "string",
      "enum": [
        "integer",
        "string"
      ]
    },
    "ProjectNumericSubtype": {
      "type": "string",
      "enum": [
        "integer",
        "double"
      ]
    },
    "ProjectPanel": {
      "type": "object",
      "description": "A panel over sources.",
      "required": [
        "panel_id",
        "members"
      ],
      "properties": {
        "comment": {
          "type": [
            "string",
            "null"
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Source names."
        },
        "panel_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ProjectPeriodRange": {
      "type": "object",
      "description": "The `{\"from\": ..., \"to\": ...}` range.",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/ProjectPeriodValue"
        },
        "to": {
          "$ref": "#/$defs/ProjectPeriodValue"
        }
      },
      "additionalProperties": false
    },
    "ProjectPeriodSegment": {
      "oneOf": [
        {
          "$ref": "#/$defs/ProjectPeriodValue"
        },
        {
          "$ref": "#/$defs/ProjectPeriodRange"
        }
      ],
      "description": "One contiguous piece of a source period."
    },
    "ProjectPeriodValue": {
      "oneOf": [
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "string"
        }
      ],
      "description": "A period endpoint as written: an int year or a period-token string (`\"_default\"`\nincluded, which only a scalar source period may hold)."
    },
    "ProjectSource": {
      "type": "object",
      "description": "One table, a requested period and its variables.",
      "required": [
        "name",
        "table",
        "period",
        "bindings"
      ],
      "properties": {
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectBinding"
          }
        },
        "name": {
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/ProjectSourcePeriod"
        },
        "table": {
          "type": "string",
          "description": "A table's public id: `<provider>/<register>` for a register's implicit table,\nelse `<provider>/<register>/<table>`."
        }
      },
      "additionalProperties": false
    },
    "ProjectSourcePeriod": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectPeriodSegment"
          }
        },
        {
          "$ref": "#/$defs/ProjectPeriodSegment"
        }
      ],
      "description": "One period, or a sorted list of periods for an interrupted series."
    },
    "ProjectStudyWindow": {
      "type": "object",
      "description": "The optional study window, in plain int years.",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "integer",
          "format": "int64"
        },
        "to": {
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false
    }
  }
}
