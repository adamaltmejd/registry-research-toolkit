# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
# Root-anchored: only the repo-root packaging dir, so a source package named
# `build/` elsewhere stays tracked.
/build/

# Environments
.venv/
.env
.envrc

# Tools
.ruff_cache/
.pytest_cache/
.hypothesis/
# Cargo workspace build output (root Cargo.toml)
/target/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Project
.tmp/

# Input data lives in the private registry-catalog-inputs repository. Old local
# worktrees still carry stale copies (incl. confidential SWECOV extracts); this line
# keeps them out of `git add`. Delete it once no local worktree carries
# reg_meta_build/input_data/.
reg_meta_build/input_data/

# Personal exploration scripts (not part of the toolkit's curated scripts/)
scripts/sample_*.py

# reg_meta database (built from SCB exports, not committed)
*.db

# SCB source PDFs (binary, copyrighted, not committed)
*.pdf
!crates/reg-build/fixture/**/*.pdf

# Marker raw output (regenerable from PDFs + parser)
reg_meta_build/docs/_raw/

# Archive (concluded investigations, ad-hoc scripts, internal notes)
archive/

# Claude Code harness state (transient locks, per-user settings, worktree shims).
# `.claude/skills/` is intentionally tracked for shared skills, so ignore the
# transient pieces individually rather than blanket-ignoring `.claude/`.
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/settings.local.json

# Host-local state that never reaches Git: scratch probes, benchmarks, verification
# receipts, and the accepted catalog-input repository, input candidates and private
# compiler proofs under it.
.local/
