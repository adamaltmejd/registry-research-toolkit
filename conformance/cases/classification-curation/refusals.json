[
  {
    "name": "inventory-metadata-reopens-binding-premise",
    "file": "curation/classifications.toml",
    "before": "name = \"First synthetic edition\"",
    "after": "name = \"Reviewed name changed\"",
    "command": "build",
    "expected": [
      "curation.toml:1: premise-changed:",
      "inventory"
    ]
  },
  {
    "name": "unresolved-exact-version-refused-at-statement",
    "file": "curation/registers/demo/pins/curation.toml",
    "before": "class/kind/v1",
    "after": "class/kind/absent",
    "command": "lock",
    "expected": [
      "curation.toml:1: unresolved classification reference",
      "class/kind/absent"
    ]
  },
  {
    "name": "inventory-reader-reference-refused-at-entry",
    "file": "curation/classifications.toml",
    "before": "codes/kind.csv",
    "after": "codes/missing.csv",
    "command": "lock",
    "expected": [
      "classifications.toml:2:",
      "codes/missing.csv"
    ]
  },
  {
    "name": "inventory-succession-cycle-refused-at-entry",
    "file": "curation/classifications.toml",
    "before": "name = \"First synthetic edition\"",
    "after": "succeeds = [\"class/kind/v2\"]\nname = \"First synthetic edition\"",
    "command": "lock",
    "expected": [
      "classifications.toml:2: classification-succession-cycle: class/kind/v1"
    ]
  },
  {
    "name": "conflicting-family-metadata-refused-at-entry",
    "file": "curation/classifications.toml",
    "before": "family_name = \"Synthetic kinds\"",
    "after": "family_name = \"Conflicting family name\"",
    "command": "lock",
    "expected": [
      "classifications.toml:",
      "classification-family-conflict: family_name"
    ]
  },
  {
    "name": "source-cannot-bind-curated-version",
    "file": "inputs/frame/pins.jsonl",
    "before": "\"label\":\"Code\",\"dtype\":\"int\"",
    "after": "\"label\":\"Code\",\"classification\":\"class/kind/v1\",\"dtype\":\"int\"",
    "command": "lock",
    "expected": [
      "frame/pins.jsonl: line 7: classification is curated; use set classification"
    ]
  },
  {
    "name": "duplicate-inventory-version-refused-at-entry",
    "file": "curation/classifications.toml",
    "before": "version = \"v2\"",
    "after": "version = \"v1\"",
    "command": "lock",
    "expected": [
      "classifications.toml:17: duplicate classification version; first at"
    ]
  },
  {
    "name": "dangling-inventory-predecessor-refused-at-entry",
    "file": "curation/classifications.toml",
    "before": "succeeds = [\"class/kind/v1\"]",
    "after": "succeeds = [\"class/kind/absent\"]",
    "command": "lock",
    "expected": [
      "classifications.toml:17: classification-reference-unresolved: predecessor \"class/kind/absent\""
    ]
  }
]
