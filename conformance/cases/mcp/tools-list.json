[
  {
    "name": "search",
    "description": "Search the catalog's registers, variables, classifications and codes in one ranked list. `q` is free text; `type` keeps one kind of hit; `register` (a FQID or a bare name) and `period` (2019, 2015..2019, LA2019, 2019-03) filter; pass `next_cursor` back as `cursor` for the next page.",
    "inputSchema": {
      "$defs": {
        "Scope": {
          "description": "The read scope (section 7); every read takes it.",
          "enum": [
            "holdings",
            "reference"
          ],
          "type": "string"
        }
      },
      "properties": {
        "cursor": {
          "type": "string"
        },
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "period": {
          "type": "string"
        },
        "q": {
          "type": "string"
        },
        "register": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "type": {
          "enum": [
            "register",
            "variable",
            "classification",
            "classification_code",
            "register_value"
          ],
          "type": "string"
        }
      },
      "required": [
        "q"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Error": {
          "description": "The error document `{code, class, message, remediation, fields}` (section 7).",
          "properties": {
            "class": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "fields": {
              "type": "object"
            },
            "message": {
              "type": "string"
            },
            "remediation": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "class",
            "message",
            "remediation",
            "fields"
          ],
          "type": "object"
        },
        "GroupMember": {
          "properties": {
            "delivery_column": {
              "type": [
                "string",
                "null"
              ]
            },
            "fqid": {
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "fqid"
          ],
          "type": "object"
        },
        "Meta": {
          "description": "The response `meta` (`shape.Meta`).",
          "properties": {
            "contract_version": {
              "type": "string"
            },
            "generation": {
              "type": "string"
            },
            "scope": {
              "$ref": "#/$defs/Scope"
            }
          },
          "required": [
            "contract_version",
            "generation",
            "scope"
          ],
          "type": "object"
        },
        "Scope": {
          "description": "The read scope (section 7); every read takes it.",
          "enum": [
            "holdings",
            "reference"
          ],
          "type": "string"
        },
        "SearchHit": {
          "description": "`shape.SearchHit`, of the types the variable arm returns.",
          "oneOf": [
            {
              "properties": {
                "definition": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "delivery_column_names": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "fqid": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "operational_definition": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "register_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "type": {
                  "enum": [
                    "variable"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "delivery_column_names",
                "type"
              ],
              "type": "object"
            },
            {
              "properties": {
                "key": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "matched_count": {
                  "minimum": 0,
                  "type": "integer"
                },
                "members": {
                  "items": {
                    "$ref": "#/$defs/GroupMember"
                  },
                  "type": "array"
                },
                "register_name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "type": {
                  "enum": [
                    "group"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "key",
                "label",
                "matched_count",
                "members",
                "type"
              ],
              "type": "object"
            }
          ]
        },
        "SearchPage": {
          "description": "`Page<SearchHit>`.",
          "properties": {
            "items": {
              "items": {
                "$ref": "#/$defs/SearchHit"
              },
              "type": "array"
            },
            "next_cursor": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "items"
          ],
          "type": "object"
        }
      },
      "oneOf": [
        {
          "properties": {
            "data": {
              "$ref": "#/$defs/SearchPage"
            },
            "meta": {
              "$ref": "#/$defs/Meta"
            }
          },
          "required": [
            "data",
            "meta"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "$ref": "#/$defs/Error"
            },
            "meta": {
              "$ref": "#/$defs/Meta"
            }
          },
          "required": [
            "error",
            "meta"
          ],
          "type": "object"
        }
      ],
      "type": "object"
    }
  }
]
