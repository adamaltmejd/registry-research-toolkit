  {
    "name": "schema",
    "description": "`operation` names one of these operations; the other arguments are its parameters (`?` marks an optional one).\n- `schema` (ref, period?, table?, limit?, cursor?): The columns of a table, a register's tables or one variable's tables over a period: one line per variable and delivered spelling, with its type, length, value set and role.\n- `diff` (ref, from, to, table?): A table's or a register's schema at two periods, joined on variable: what was added, removed or changed (spelling, type, length, value set). A rename is a changed spelling.",
    "inputSchema": {
      "properties": {
        "cursor": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "operation": {
          "enum": [
            "schema",
            "diff"
          ],
          "type": "string"
        },
        "period": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "operation"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Diff": {
          "description": "`shape.Diff`.",
          "properties": {
            "fqid": {
              "type": "string"
            },
            "from": {
              "description": "The request's `from`.",
              "type": "string"
            },
            "tables": {
              "items": {
                "$ref": "#/$defs/DiffTable"
              },
              "type": "array"
            },
            "to": {
              "description": "The request's `to`.",
              "type": "string"
            }
          },
          "required": [
            "fqid",
            "from",
            "to",
            "tables"
          ],
          "type": "object"
        },
        "DiffChange": {
          "description": "One field that differs between the two periods: `spelling`, `type`, `length` or\n`value_set`.",
          "properties": {
            "field": {
              "type": "string"
            },
            "from": {},
            "to": {}
          },
          "required": [
            "field",
            "from",
            "to"
          ],
          "type": "object"
        },
        "DiffChanged": {
          "properties": {
            "changes": {
              "items": {
                "$ref": "#/$defs/DiffChange"
              },
              "type": "array"
            },
            "variable": {
              "type": "string"
            }
          },
          "required": [
            "variable",
            "changes"
          ],
          "type": "object"
        },
        "DiffSummary": {
          "properties": {
            "added": {
              "minimum": 0,
              "type": "integer"
            },
            "changed": {
              "minimum": 0,
              "type": "integer"
            },
            "removed": {
              "minimum": 0,
              "type": "integer"
            },
            "unchanged": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "added",
            "removed",
            "changed",
            "unchanged"
          ],
          "type": "object"
        },
        "DiffTable": {
          "properties": {
            "added": {
              "items": {
                "$ref": "#/$defs/SchemaLine"
              },
              "type": "array"
            },
            "changed": {
              "items": {
                "$ref": "#/$defs/DiffChanged"
              },
              "type": "array"
            },
            "removed": {
              "items": {
                "$ref": "#/$defs/SchemaLine"
              },
              "type": "array"
            },
            "summary": {
              "$ref": "#/$defs/DiffSummary"
            },
            "table": {
              "type": "string"
            }
          },
          "required": [
            "table",
            "added",
            "removed",
            "changed",
            "summary"
          ],
          "type": "object"
        },
        "Error": {
          "description": "The error document `{code, class, message, remediation, fields}`.",
          "properties": {
            "class": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "fields": {
              "type": "object"
            },
            "message": {
              "type": "string"
            },
            "remediation": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "class",
            "message",
            "remediation",
            "fields"
          ],
