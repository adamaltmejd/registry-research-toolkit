          "type": "object"
        },
        "Meta": {
          "description": "The response `meta` (`shape.Meta`).",
          "properties": {
            "contract_version": {
              "type": "string"
            },
            "generation": {
              "type": "string"
            },
            "scope": {
              "$ref": "#/$defs/Scope"
            }
          },
