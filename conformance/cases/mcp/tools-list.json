              "description": "A variable's folded spellings with the periods each was delivered under;\n`null` for a register or a table.",
              "items": {
                "$ref": "#/$defs/CoverageColumn"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "fqid": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "period": {
              "$ref": "#/$defs/Period",
              "description": "The entity's hull."
            },
            "tables": {
              "items": {
                "$ref": "#/$defs/CoverageTable"
              },
              "type": "array"
            }
          },
          "required": [
