      "$defs": {
        "Scope": {
          "description": "The read scope (section 7); every read takes it.",
          "enum": [
            "holdings",
            "reference"
          ],
          "type": "string"
        }
      },
      "properties": {
        "cursor": {
          "type": "string"
        },
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "period": {
          "type": "string"
        },
        "q": {
          "type": "string"
        },
        "register": {
