{
  "components": {
    "schemas": {
      "BindingChild": {
        "description": "A binding child under a register node \u2014 a thin (fqid, name) entry, NOT\nthe embedded longitudinal record (that is only on the binding LEAF response).",
        "properties": {
          "fqid": {
            "title": "Fqid",
            "type": "string"
          },
          "kind": {
            "const": "binding",
            "default": "binding",
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "fqid"
        ],
        "title": "BindingChild",
        "type": "object"
      },
      "BindingNode": {
        "description": "A binding LEAF (3-seg FQID) \u2014 the addressable variable plus its FULL\nlongitudinal record embedded from one `Catalog.resolve` call (\u00a79.5): shared\nmetadata, every state (each tagged with its variant), and the variable-grain\n`same_as` / `replaced_by` / `related_to` / `lineage` edges.\n\n`lineage_warnings` are intentionally OMITTED \u2014 `ResolvedVariable` doesn't\ncarry them; they arrive via A5.2's `/lineage_warnings` endpoint. This full-node\nshape is the binding leaf with NO narrowing query: a `?period` resolves via\n`resolve_at` (\u2192 `StatesResponse`) instead, and a narrowing modifier (`?variant`\n/ `?value_set_version` / an `@version` pin) WITHOUT `?period` is a 422 \u2014 it is\ninert without a period, so it errors rather than silently embedding full\nhistory.",
        "properties": {
          "definition": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Definition"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "fqid": {
            "title": "Fqid",
            "type": "string"
          },
          "is_identifier": {
            "title": "Is Identifier",
            "type": "boolean"
          },
          "is_sensitive": {
            "title": "Is Sensitive",
            "type": "boolean"
          },
          "kind": {
            "const": "binding",
            "default": "binding",
            "title": "Kind",
            "type": "string"
          },
          "lineage": {
            "items": {
              "$ref": "#/components/schemas/LineageEdgeModel"
            },
            "title": "Lineage",
            "type": "array"
          },
          "measurement_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measurement Unit"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "register_id": {
            "title": "Register Id",
            "type": "integer"
          },
          "related_to": {
            "items": {
              "$ref": "#/components/schemas/RelatedRefModel"
            },
            "title": "Related To",
            "type": "array"
          },
          "replaced_by": {
            "items": {
              "$ref": "#/components/schemas/VariableRefModel"
            },
            "title": "Replaced By",
            "type": "array"
          },
          "same_as": {
            "items": {
              "$ref": "#/components/schemas/VariableRefModel"
            },
            "title": "Same As",
            "type": "array"
          },
          "source_register_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Register Id"
          },
          "source_register_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Register Text"
          },
          "states": {
            "items": {
              "$ref": "#/components/schemas/VariableStateModel"
            },
            "title": "States",
            "type": "array"
          },
          "variable_id": {
            "title": "Variable Id",
            "type": "integer"
          },
          "via_same_as": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Via Same As"
          }
        },
        "required": [
          "fqid",
          "variable_id",
          "register_id",
          "name",
          "definition",
          "description",
          "measurement_unit",
          "is_sensitive",
          "is_identifier",
          "source_register_id",
          "source_register_text",
          "states",
          "same_as",
          "replaced_by",
          "related_to",
          "lineage"
        ],
        "title": "BindingNode",
        "type": "object"
      },
      "ClassificationNode": {
        "description": "A classification leaf (`class/<slug>`, 2 seg).",
        "properties": {
          "fqid": {
            "title": "Fqid",
            "type": "string"
          },
