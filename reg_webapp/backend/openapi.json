  "info": {
    "title": "reg_webapp",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/catalog": {
      "get": {
        "description": "The catalog root: every provider plus the classification-root sentinel.",
        "operationId": "get_catalog_root_api_catalog_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RootResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Catalog Root"
      }
    },
    "/api/catalog/{fqid}": {
      "get": {
        "description": "Resolve any catalog node by FQID path; on a binding leaf, an optional\n`?period` (with `?variant` / `?value_set_version`) narrows to the resolve_at\nstate subset.\n\nThe \u00a716 guards (`_validated_fqid` for the path, `_validated_period` /\n`_validated_variant` for the queries) run as dependencies, BEFORE this body \u2014\nso a malformed path OR a malformed period/variant returns 422 **before** any\nconnection opens (zero SQL, zero opens). `parse` is DB-free and runs before\nthe open too. The classification-root literal `class` (1 seg) is special-cased\nbefore `parse`.\n\n`?period` semantics (\u00a79.5): present + binding leaf \u2192 `{states: [...]}` (the\nresolve_at subset, narrowed by `?variant` / `?value_set_version`; the leaf's\n`@version` pin reconciles with `?value_set_version` \u2014 equal/one-sided uses it,\nconflicting is 422). present + non-binding kind \u2192 IGNORED (resolve normally).\nabsent on a binding leaf \u2192 the full node (full history) UNLESS a narrowing\nmodifier (`?variant` / `?value_set_version` / `@version`) is set: those are inert\nwithout `?period`, so they 422 (\"requires ?period\") rather than silently no-op.\nabsent on a non-binding kind \u2192 the full node. The connection is opened and used\nwithin this sync body (one thread \u2014 see `_catalog_conn`).",
        "operationId": "get_catalog_node_api_catalog__fqid__get",
        "parameters": [
          {
            "in": "path",
            "name": "fqid",
            "required": true,
            "schema": {
              "title": "Fqid",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "period",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Period"
            }
          },
          {
            "in": "query",
            "name": "variant",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Variant"
            }
          },
          {
            "in": "query",
            "name": "value_set_version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Value Set Version"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "discriminator": {
                        "mapping": {
                          "binding": "#/components/schemas/BindingNode",
                          "classification": "#/components/schemas/ClassificationNode",
                          "classification-root": "#/components/schemas/ClassificationRootResponse",
                          "provider": "#/components/schemas/ProviderResponse",
                          "register": "#/components/schemas/RegisterResponse"
                        },
                        "propertyName": "kind"
                      },
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/ProviderResponse"
                        },
                        {
                          "$ref": "#/components/schemas/RegisterResponse"
                        },
                        {
                          "$ref": "#/components/schemas/BindingNode"
                        },
                        {
                          "$ref": "#/components/schemas/ClassificationRootResponse"
                        },
                        {
                          "$ref": "#/components/schemas/ClassificationNode"
                        }
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/StatesResponse"
                    }
                  ],
                  "title": "Response Get Catalog Node Api Catalog  Fqid  Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Catalog Node"
      }
    },
    "/api/catalog/{fqid}/lineage": {
      "get": {
        "description": "Consumer-side composite lineage edges (state grain, \u00a75.6). Maps what\nreg_meta's `LineageEdge` carries; the \u00a79.5 richer per-source-state shape is a\npossible reg_meta enhancement (not blocked on here \u2014 see DESIGN.md).",
        "operationId": "get_binding_lineage_api_catalog__fqid__lineage_get",
        "parameters": [
