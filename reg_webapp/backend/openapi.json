          "warning_kind",
          "message"
        ],
        "title": "LineageWarningModel",
        "type": "object"
      },
      "LineageWarningsResponse": {
        "description": "`GET /api/catalog/{fqid}/lineage_warnings` \u2014 build-time lineage warnings\n(\u00a75.6 / \u00a79.5). Empty list when lineage resolved cleanly.",
