// Cloudflare edge worker for the global catalog's hosted MCP (crates/DESIGN.md,
// "Hosted MCP").
//
// MCP only, on reg-meta.vqv.uk. The worker forwards `/mcp` to the zone's DNS
// origin (the Fly app — the proxied A/AAAA records for reg-meta.vqv.uk) with the edge token, and answers anything else with a
// 404. See reg_webapp/DESIGN.md → "Deployment" for the topology.
//
// Deploy:
//
//   bunx wrangler deploy --config reg_webapp/edge/wrangler.jsonc
{
  // The worker name holds the EDGE_TOKEN secret; renaming it drops the secret.
  "name": "reg-webapp-global-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "vars": { "STEWARD": "global" },
  // `wrangler deploy` replaces the worker's routes with this list.
  "routes": [{ "pattern": "reg-meta.vqv.uk/*", "zone_name": "vqv.uk" }],
  // Usage statistics (src/usage.ts, reg_webapp/DESIGN.md → "Usage statistics"):
  // Analytics Engine keeps data points 3 months. Invocation logs are off: they record
  // each request's URL, search text included, outside the usage scrub.
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "reg_meta_usage" }],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
