// Cloudflare edge worker for the reg_webapp `swecov` deployment
// (reg_webapp/DESIGN.md, "Deployment").
//
// Serves the SPA as Workers static assets on data.swecov.se and passes API
// traffic through to the zone's DNS origin (the Fly app — the proxied A/AAAA
// records for data.swecov.se). Same Worker code as the global catalog's MCP-only
// worker (wrangler.jsonc), under its own name so each gets its own DEPLOY_VERSION
// cache generation. It sets ROUTE_MCP: SWECOV's artifact is public, so its catalog
// is served over hosted MCP (crates/DESIGN.md, "Hosted MCP"). See
// reg_webapp/DESIGN.md → "Deployment" for the topology and DESIGN.md → "SPA
// routing + production fallback" for why the edge owns the deep-link →
// index.html rewrite.
//
// Deploy (after building the SPA: `bun run gen:wasm && bun run gen:types && bun run build` in
// reg_webapp/frontend/):
//
//   bunx wrangler deploy --config reg_webapp/edge/wrangler.swecov.jsonc \
//     --var DEPLOY_VERSION:"$(git rev-parse HEAD)-manual-$(date +%s)"
{
  "name": "reg-webapp-swecov-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // DEPLOY_VERSION is the API cache generation (#318): src/index.ts stamps it
  // onto every origin-bound URL, so each deploy with a NEW value orphans all
  // prior /api/* edge-cache entries. CI overrides this default per deploy
  // (--var in container-build.yml); manual deploys must pass a fresh value too
  // (command above) — `wrangler deploy` REPLACES the var set, so deploying
  // with this literal default would reuse the "dev" generation and can
  // resurface stale entries from an earlier "dev" deploy.
  "vars": { "DEPLOY_VERSION": "dev", "ROUTE_MCP": "true" },
  "assets": {
    // Relative to this config file.
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    // Deep links to client routes (/catalog/...) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Origin-owned paths ALWAYS hit the worker (→ origin), never the SPA
    // fallback. Without this, single-page-application mode serves index.html
    // to browser navigation requests directly, shadowing /api deep-opens.
    // LOCKSTEP: this glob list and ORIGIN_PATHS (plus MCP_PATH, which
    // ROUTE_MCP enables) in src/index.ts encode the same set — edit
    // them together; `reg-meta serve` owns which paths exist. `/assets/*` is
    // the worker's too (ASSETS_PATH in src/index.ts): a missing hashed asset is
    // a 404 there, never the SPA fallback.
    "run_worker_first": ["/api", "/api/*", "/openapi.json", "/mcp", "/assets/*"]
  },
  "routes": [{ "pattern": "data.swecov.se/*", "zone_name": "swecov.se" }],
  "observability": { "enabled": true }
}
