{
  "name": "reg-webapp-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
    "lint": "biome check && oxlint --deny-warnings && bun run lint:design && bun run lint:tokens",
    "lint:design": "bunx @google/design.md lint DESIGN.md",
    "lint:tokens": "bun scripts/lint_tokens.ts",
    "format": "biome format --write .",
    "test": "vitest run",
    "gen:wasm": "cargo build -q --locked -p reg-core-wasm --target wasm32-unknown-unknown --profile wasm && wasm-bindgen --target web --remove-name-section --remove-producers-section --out-dir src/lib/reg-core-wasm ../../target/wasm32-unknown-unknown/wasm/reg_core_wasm.wasm",
    "gen:types": "openapi-typescript ../../crates/reg-meta/openapi.json -o src/lib/api-types-rust.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@google/design.md": "0.4.0",
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "agent-browser": "0.42.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.93.0",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  }
}
