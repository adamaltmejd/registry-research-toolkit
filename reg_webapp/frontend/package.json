{
  "name": "reg-webapp-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "lint": "biome check && bun run lint:design",
    "lint:design": "bunx @google/design.md lint DESIGN.md",
    "format": "biome format --write .",
    "test": "vitest run",
    "gen:types": "openapi-typescript ../backend/openapi.json -o src/lib/api-types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@google/design.md": "0.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/browser-playwright": "5.0.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "~6.0.3",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vitest-browser-svelte": "3.1.0"
  },
  "dependencies": {
    "bits-ui": "2.19.1"
  }
}
