{
  "name": "reg-webapp-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo --fail-on-warnings",
    "lint": "biome check && bun run lint:design && bun run lint:tokens",
    "lint:design": "bunx @google/design.md lint DESIGN.md",
    "lint:tokens": "bun scripts/lint_tokens.ts",
    "format": "biome format --write .",
    "test": "vitest run",
    "gen:wasm": "cargo build -q --locked -p reg-core-wasm --target wasm32-unknown-unknown --profile wasm && wasm-bindgen --target web --remove-name-section --remove-producers-section --out-dir src/lib/reg-core-wasm ../../target/wasm32-unknown-unknown/wasm/reg_core_wasm.wasm",
    "gen:types": "openapi-typescript ../../crates/reg-meta/openapi.json -o src/lib/api-types-rust.ts && bun scripts/gen_project_schema.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@google/design.md": "0.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.0.5",
    "agent-browser": "0.39.1",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-browser-svelte": "3.1.0"
  },
  "dependencies": {
    "bits-ui": "2.20.0"
  }
}
