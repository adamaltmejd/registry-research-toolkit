{
  "openapi": "3.1.0",
  "info": {
    "title": "reg-meta",
    "version": "0"
  },
  "paths": {
    "/api/context": {
      "get": {
        "description": "The catalog's identity and headline counts, for the SPA.",
        "operationId": "context",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Context"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error in `api/errors.toml`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Context": {
        "type": "object",
        "description": "`shape.Context`.",
        "required": [
          "catalog_version",
          "schema_version",
          "period_span",
          "reg_meta_version",
          "sizes"
        ],
        "properties": {
          "catalog_version": {
            "type": "string"
          },
          "period_span": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Period",
                "description": "The hull of every register; `null` for a catalog without registers."
              },
              {
                "type": "null"
              }
            ]
          },
          "reg_meta_version": {
            "type": "string",
            "description": "The server's version, which seeds a new project's `reg_meta_version`."
          },
          "schema_version": {
            "type": "string"
          },
          "sizes": {
            "$ref": "#/components/schemas/Sizes"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "The error document `{code, class, message, remediation, fields}`.",
        "required": [
          "code",
          "class",
          "message",
          "remediation",
          "fields"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        }
      },
      "Meta": {
        "type": "object",
        "description": "The response `meta` (`shape.Meta`).",
        "required": [
          "contract_version",
          "generation",
          "catalog_version"
        ],
        "properties": {
          "catalog_version": {
            "type": "string"
          },
          "contract_version": {
            "type": "string"
          },
          "generation": {
            "type": "string"
          }
        }
      },
      "Period": {
        "type": "object",
        "description": "`shape.Period`: a half-open `[start, end)` of ISO days, `null` for an open end.",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "end": {
            "type": [
              "string",
              "null"
            ]
          },
          "start": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ProjectBinding": {
        "type": "object",
        "description": "One variable to extract.",
        "required": [
          "variable",
          "type"
        ],
        "properties": {
          "classification": {
            "type": [
              "string",
              "null"
            ],
            "description": "A classification version's public id `class/<family>/<version>`.",
            "pattern": "^class/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$"
          },
          "date_format": {
            "type": [
              "string",
              "null"
            ]
          },
          "datetime_format": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "id_subtype": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProjectIdSubtype"
              },
              {
                "type": "null"
              }
            ]
          },
          "numeric_subtype": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProjectNumericSubtype"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "$ref": "#/components/schemas/ProjectColumnType"
          },
          "variable": {
            "type": "string",
            "description": "The binding FQID `<provider>/<register>/<slug>`."
          }
        },
        "additionalProperties": false
      },
      "ProjectColumnType": {
        "type": "string",
        "enum": [
          "id",
          "categorical",
          "numeric",
          "date",
          "datetime",
          "opaque"
        ]
      },
      "ProjectData": {
        "type": "object",
        "description": "The top-level `project_data.json` document.",
        "required": [
          "schema_version",
          "reg_meta_version",
          "name",
          "sources"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "panels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectPanel"
            }
          },
          "reg_meta_version": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSource"
            }
          },
          "window": {
            "$ref": "#/components/schemas/ProjectStudyWindow"
          }
        },
        "additionalProperties": false
      },
      "ProjectEdition": {
        "type": "string",
        "enum": [
          "final",
          "unstated",
          "preliminary"
        ]
      },
      "ProjectIdSubtype": {
        "type": "string",
        "enum": [
          "integer",
          "string"
        ]
      },
      "ProjectNumericSubtype": {
        "type": "string",
        "enum": [
          "integer",
          "double"
        ]
      },
      "ProjectPanel": {
        "type": "object",
        "description": "A panel over sources.",
        "required": [
          "panel_id",
          "members"
        ],
        "properties": {
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Source names."
          },
          "panel_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ProjectPeriodRange": {
        "type": "object",
        "description": "The `{\"from\": ..., \"to\": ...}` range.",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "$ref": "#/components/schemas/ProjectPeriodValue"
          },
          "to": {
            "$ref": "#/components/schemas/ProjectPeriodValue"
          }
        },
        "additionalProperties": false
      },
      "ProjectPeriodSegment": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ProjectPeriodValue"
          },
          {
            "$ref": "#/components/schemas/ProjectPeriodRange"
          }
        ],
        "description": "One contiguous piece of a source period."
      },
      "ProjectPeriodValue": {
        "oneOf": [
          {
            "type": "integer",
            "format": "int64"
          },
          {
            "type": "string"
          }
        ],
        "description": "A period endpoint as written: an int year or a period-token string (`\"_default\"`\nincluded, which only a scalar source period may hold)."
      },
      "ProjectSource": {
        "type": "object",
        "description": "One logical extraction: a table, a requested period and its bindings.",
        "required": [
          "name",
          "table",
          "period",
          "bindings"
        ],
        "properties": {
          "bindings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectBinding"
            }
          },
          "edition": {
            "$ref": "#/components/schemas/ProjectEdition",
            "description": "The release of the table asked for; absent asks for the primary edition."
          },
          "name": {
            "type": "string"
          },
          "period": {
            "$ref": "#/components/schemas/ProjectSourcePeriod"
          },
          "qualifier": {
            "type": "string",
            "description": "The delivery qualifier asked for; absent asks for every qualifier."
          },
          "table": {
            "type": "string",
            "description": "A table's public id: `<provider>/<register>` for a register's implicit table,\nelse `<provider>/<register>/<table>`."
          }
        },
        "additionalProperties": false
      },
      "ProjectSourcePeriod": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectPeriodSegment"
            }
          },
          {
            "$ref": "#/components/schemas/ProjectPeriodSegment"
          }
        ],
        "description": "`Source.period`: one segment, or a sorted, disjoint list of them (an interrupted\nseries)."
      },
      "ProjectStudyWindow": {
        "type": "object",
        "description": "The optional study window, in plain int years.",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "format": "int64"
          },
          "to": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "Sizes": {
        "type": "object",
        "description": "Every provider, register, table (implicit ones included) and variable.",
        "required": [
          "providers",
          "registers",
          "tables",
          "variables"
        ],
        "properties": {
          "providers": {
            "type": "integer",
            "format": "int64"
          },
          "registers": {
            "type": "integer",
            "format": "int64"
          },
          "tables": {
            "type": "integer",
            "format": "int64"
          },
          "variables": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  }
}
