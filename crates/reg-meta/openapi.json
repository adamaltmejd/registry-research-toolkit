{
  "openapi": "3.1.0",
  "info": {
    "title": "reg-meta",
    "version": "0"
  },
  "paths": {
    "/api/catalog": {
      "get": {
        "description": "The summary of a provider, register, table or variable by public id or bare name; without a ref, the catalog's providers.",
        "operationId": "show_without_ref",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Show"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error in `api/errors.toml`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/{ref}": {
      "get": {
        "description": "The summary of a provider, register, table or variable by public id or bare name; without a ref, the catalog's providers.",
        "operationId": "show",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Show"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error in `api/errors.toml`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/context": {
      "get": {
        "description": "The catalog's identity and headline counts, for the SPA.",
        "operationId": "context",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Context"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error in `api/errors.toml`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/resolve": {
      "get": {
        "description": "Match delivered column names (at most 200) to variables, optionally within one register. A name that matches nothing is reported as unmatched.",
        "operationId": "resolve",
        "parameters": [
          {
            "name": "columns",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 200
            }
          },
          {
            "name": "register",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Resolved"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error in `api/errors.toml`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Context": {
        "type": "object",
        "description": "`shape.Context`.",
        "required": [
          "catalog_version",
          "schema_version",
          "period_span",
          "reg_meta_version",
          "sizes"
        ],
        "properties": {
          "catalog_version": {
            "type": "string"
          },
          "period_span": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Period",
                "description": "The hull of every register; `null` for a catalog without registers."
              },
              {
                "type": "null"
              }
            ]
          },
          "reg_meta_version": {
            "type": "string",
            "description": "The server's version, which seeds a new project's `reg_meta_version`."
          },
          "schema_version": {
            "type": "string"
          },
          "sizes": {
            "$ref": "#/components/schemas/Sizes"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "The error document `{code, class, message, remediation, fields}`.",
        "required": [
          "code",
          "class",
          "message",
          "remediation",
          "fields"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        }
      },
      "Meta": {
        "type": "object",
        "description": "The response `meta` (`shape.Meta`).",
        "required": [
          "contract_version",
          "generation",
          "catalog_version"
        ],
        "properties": {
          "catalog_version": {
            "type": "string"
          },
          "contract_version": {
            "type": "string"
          },
          "generation": {
            "type": "string"
          }
        }
      },
      "Period": {
        "type": "object",
        "description": "`shape.Period`: a half-open `[start, end)` of ISO days, `null` for an open end.",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "end": {
            "type": [
              "string",
              "null"
            ]
          },
          "start": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Population": {
        "type": "object",
        "description": "One population a release states (`shape.Release.populations`).",
        "required": [
          "name",
          "definition",
          "ref_day"
        ],
        "properties": {
          "definition": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "ref_day": {
            "type": [
              "string",
              "null"
            ],
            "description": "The ISO day the population is stated for."
          }
        }
      },
      "ProjectBinding": {
        "type": "object",
        "description": "One variable to extract.",
        "required": [
          "variable",
          "type"
        ],
        "properties": {
          "classification": {
            "type": [
              "string",
              "null"
            ],
            "description": "A classification version's public id `class/<family>/<version>`.",
            "pattern": "^class/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$"
          },
          "date_format": {
            "type": [
              "string",
              "null"
            ]
          },
          "datetime_format": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "id_subtype": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProjectIdSubtype"
              },
              {
                "type": "null"
              }
            ]
          },
          "numeric_subtype": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProjectNumericSubtype"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "$ref": "#/components/schemas/ProjectColumnType"
          },
          "variable": {
            "type": "string",
            "description": "The binding FQID `<provider>/<register>/<slug>`."
          }
        },
        "additionalProperties": false
      },
      "ProjectColumnType": {
        "type": "string",
        "enum": [
          "id",
          "categorical",
          "numeric",
          "date",
          "datetime",
          "opaque"
        ]
      },
      "ProjectData": {
        "type": "object",
        "description": "The top-level `project_data.json` document.",
        "required": [
          "schema_version",
          "reg_meta_version",
          "name",
          "sources"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "panels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectPanel"
            }
          },
          "reg_meta_version": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSource"
            }
          },
          "window": {
            "$ref": "#/components/schemas/ProjectStudyWindow"
          }
        },
        "additionalProperties": false
      },
      "ProjectEdition": {
        "type": "string",
        "enum": [
          "final",
          "unstated",
          "preliminary"
        ]
      },
      "ProjectIdSubtype": {
        "type": "string",
        "enum": [
          "integer",
          "string"
        ]
      },
      "ProjectNumericSubtype": {
        "type": "string",
        "enum": [
          "integer",
          "double"
        ]
      },
      "ProjectPanel": {
        "type": "object",
        "description": "A panel over sources.",
        "required": [
          "panel_id",
          "members"
        ],
        "properties": {
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Source names."
          },
          "panel_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ProjectPeriodRange": {
        "type": "object",
        "description": "The `{\"from\": ..., \"to\": ...}` range.",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "$ref": "#/components/schemas/ProjectPeriodValue"
          },
          "to": {
            "$ref": "#/components/schemas/ProjectPeriodValue"
          }
        },
        "additionalProperties": false
      },
      "ProjectPeriodSegment": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ProjectPeriodValue"
          },
          {
            "$ref": "#/components/schemas/ProjectPeriodRange"
          }
        ],
        "description": "One contiguous piece of a source period."
      },
      "ProjectPeriodValue": {
        "oneOf": [
          {
            "type": "integer",
            "format": "int64"
          },
          {
            "type": "string"
          }
        ],
        "description": "A period endpoint as written: an int year or a period-token string (`\"_default\"`\nincluded, which only a scalar source period may hold)."
      },
      "ProjectSource": {
        "type": "object",
        "description": "One logical extraction: a table, a requested period and its bindings.",
        "required": [
          "name",
          "table",
          "period",
          "bindings"
        ],
        "properties": {
          "bindings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectBinding"
            }
          },
          "edition": {
            "$ref": "#/components/schemas/ProjectEdition",
            "description": "The release of the table asked for; absent asks for the primary edition."
          },
          "name": {
            "type": "string"
          },
          "period": {
            "$ref": "#/components/schemas/ProjectSourcePeriod"
          },
          "qualifier": {
            "type": "string",
            "description": "The delivery qualifier asked for; absent asks for every qualifier."
          },
          "table": {
            "type": "string",
            "description": "A table's public id: `<provider>/<register>` for a register's implicit table,\nelse `<provider>/<register>/<table>`."
          }
        },
        "additionalProperties": false
      },
      "ProjectSourcePeriod": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectPeriodSegment"
            }
          },
          {
            "$ref": "#/components/schemas/ProjectPeriodSegment"
          }
        ],
        "description": "`Source.period`: one segment, or a sorted, disjoint list of them (an interrupted\nseries)."
      },
      "ProjectStudyWindow": {
        "type": "object",
        "description": "The optional study window, in plain int years.",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "format": "int64"
          },
          "to": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "Release": {
        "type": "object",
        "description": "`shape.Release`: a delivery of a table.",
        "required": [
          "name",
          "period",
          "edition",
          "qualifier",
          "primary",
          "parse_state",
          "populations"
        ],
        "properties": {
          "edition": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parse_state": {
            "type": "string"
          },
          "period": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Period",
                "description": "`null` when the release is unparsed."
              },
              {
                "type": "null"
              }
            ]
          },
          "populations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Population"
            }
          },
          "primary": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "`null` when the release is unparsed."
          },
          "qualifier": {
            "type": "string"
          }
        }
      },
      "Resolved": {
        "type": "object",
        "description": "`{columns: [ResolvedColumn]}`.",
        "required": [
          "columns"
        ],
        "properties": {
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResolvedColumn"
            }
          }
        }
      },
      "ResolvedColumn": {
        "type": "object",
        "description": "`shape.ResolvedColumn`: a requested column and the variables it names.",
        "required": [
          "column",
          "status",
          "matches"
        ],
        "properties": {
          "column": {
            "type": "string",
            "description": "As asked."
          },
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResolvedMatch"
            }
          },
          "status": {
            "type": "string",
            "description": "`matched` for one variable, `ambiguous` for several, `unmatched` for none."
          }
        }
      },
      "ResolvedMatch": {
        "type": "object",
        "required": [
          "fqid",
          "name",
          "register",
          "alias"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "description": "`delivered` or `curated`."
          },
          "fqid": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "The variable's label."
          },
          "register": {
            "type": "string",
            "description": "The register's fqid."
          }
        }
      },
      "Show": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "providers",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "root"
                ]
              },
              "providers": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ShowProviderRef"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "fqid",
              "name",
              "registers",
              "kind"
            ],
            "properties": {
              "fqid": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "provider"
                ]
              },
              "name": {
                "type": "string"
              },
              "registers": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ShowRegisterRef"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "fqid",
              "name",
              "description",
              "period",
              "tables",
              "variables",
              "unplaced",
              "kind"
            ],
            "properties": {
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fqid": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "register"
                ]
              },
              "name": {
                "type": "string"
              },
              "period": {
                "$ref": "#/components/schemas/Period"
              },
              "tables": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ShowTable"
                }
              },
              "unplaced": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The literal names of the releases the reader could not place in time."
              },
              "variables": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ShowVariableRef"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "fqid",
              "name",
              "description",
              "register",
              "role",
              "implicit",
              "timeless",
              "unit_type",
              "cadence",
              "spans",
              "releases",
              "row_keys",
              "kind"
            ],
            "properties": {
              "cadence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fqid": {
                "type": "string"
              },
              "implicit": {
                "type": "boolean"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "table"
                ]
              },
              "name": {
                "type": "string"
              },
              "register": {
                "type": "string",
                "description": "The register's fqid."
              },
              "releases": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Release"
                }
              },
              "role": {
                "type": "string"
              },
              "row_keys": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ShowRowKey"
                }
              },
              "spans": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Period"
                }
              },
              "timeless": {
                "type": "boolean"
              },
              "unit_type": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "fqid",
              "name",
              "definition",
              "register",
              "period",
              "unit_types",
              "texts",
              "spellings",
              "tables",
              "kind"
            ],
            "properties": {
              "definition": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fqid": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "variable"
                ]
              },
              "name": {
                "type": "string"
              },
              "period": {
                "$ref": "#/components/schemas/Period"
              },
              "register": {
                "type": "string",
                "description": "The register's fqid."
              },
              "spellings": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ShowSpelling"
                }
              },
              "tables": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The fqids of the tables the variable has segments in."
              },
              "texts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ShowText"
                }
              },
              "unit_types": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "description": "`shape.Show`: a summary tagged by `kind`. Every kind but `root` carries the\nresolved `fqid`, so a bare-name request gets the id back."
      },
      "ShowProviderRef": {
        "type": "object",
        "required": [
          "fqid",
          "name"
        ],
        "properties": {
          "fqid": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "ShowRegisterRef": {
        "type": "object",
        "required": [
          "fqid",
          "name",
          "period"
        ],
        "properties": {
          "fqid": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "period": {
            "$ref": "#/components/schemas/Period"
          }
        }
      },
      "ShowRowKey": {
        "type": "object",
        "description": "A segment of the table that holds its rows' key.",
        "required": [
          "fqid",
          "spelling",
          "period"
        ],
        "properties": {
          "fqid": {
            "type": "string"
          },
          "period": {
            "$ref": "#/components/schemas/Period"
          },
          "spelling": {
            "type": "string"
          }
        }
      },
      "ShowSpelling": {
        "type": "object",
        "description": "A folded name the variable is known by.",
        "required": [
          "spelling",
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "`delivered` or `curated`."
          },
          "spelling": {
            "type": "string"
          }
        }
      },
      "ShowTable": {
