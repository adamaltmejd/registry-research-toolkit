{
  "openapi": "3.1.0",
  "info": {
    "title": "reg-meta",
    "version": "0"
  },
  "paths": {
    "/api/context": {
      "get": {
        "description": "The catalog's identity and headline counts, for the SPA.",
        "operationId": "context",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Context"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error in `api/errors.toml`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/segments/{ref}": {
      "get": {
        "description": "A variable's segments: its maximal runs of one form per table, in time order, each with its spelling, type, value set, flags and state. With `evidence`, each segment's source occurrences and the rule overrides that changed them.",
        "operationId": "segments",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "value_set_name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "evidence",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SegmentPage"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error in `api/errors.toml`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/values": {
      "get": {
        "description": "A value set's items, by its hash or by a classification version's ref, with a hierarchical set paged one level at a time by `parent` and searched flat by `q`; or, given a `code` and optionally its `label`, the value sets that hold that pair. The blank code is an item like any other.",
        "operationId": "values",
        "parameters": [
          {
            "name": "value_set",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          {
            "name": "classification",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "parent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/ValueItemsPage"
                        },
                        {
                          "$ref": "#/components/schemas/ValueSetsPage"
                        }
                      ]
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error in `api/errors.toml`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Context": {
        "type": "object",
        "description": "`shape.Context`.",
        "required": [
          "catalog_version",
          "schema_version",
          "period_span",
          "reg_meta_version",
          "sizes"
        ],
        "properties": {
          "catalog_version": {
            "type": "string"
          },
          "period_span": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Period",
                "description": "The hull of every register; `null` for a catalog without registers."
              },
              {
                "type": "null"
              }
            ]
          },
          "reg_meta_version": {
            "type": "string",
            "description": "The server's version, which seeds a new project's `reg_meta_version`."
          },
          "schema_version": {
            "type": "string"
          },
          "sizes": {
            "$ref": "#/components/schemas/Sizes"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "The error document `{code, class, message, remediation, fields}`.",
        "required": [
          "code",
          "class",
          "message",
          "remediation",
          "fields"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        }
      },
      "Locator": {
        "type": "object",
        "required": [
          "input",
          "locator"
        ],
        "properties": {
          "input": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          }
        }
      },
      "Meta": {
        "type": "object",
        "description": "The response `meta` (`shape.Meta`).",
        "required": [
          "contract_version",
          "generation",
          "catalog_version"
        ],
        "properties": {
          "catalog_version": {
            "type": "string"
          },
          "contract_version": {
            "type": "string"
          },
          "generation": {
            "type": "string"
          }
        }
      },
      "Occurrence": {
        "type": "object",
        "description": "One occurrence behind a segment (`shape.Segment.evidence`).",
        "required": [
          "release",
          "period",
          "spelling",
          "label",
          "source_key",
          "status",
          "locators",
          "overrides"
        ],
        "properties": {
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "locators": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Locator"
            }
          },
          "overrides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Override"
            }
          },
          "period": {
            "$ref": "#/components/schemas/Period"
          },
          "release": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Release"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_key": {
            "type": "string"
          },
          "spelling": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Override": {
        "type": "object",
        "description": "A non-source winner over one field of an occurrence.",
        "required": [
          "field",
          "value",
          "prov",
          "statement",
          "rule",
          "source_value"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "prov": {
            "type": "string"
          },
          "rule": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "statement": {
            "type": [
              "object",
              "null"
            ],
            "description": "`{file, line}` of a curated statement; always `null` in C."
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Period": {
        "type": "object",
        "description": "`shape.Period`: a half-open `[start, end)` of ISO days, `null` for an open end.",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "end": {
            "type": [
              "string",
              "null"
            ]
          },
          "start": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Population": {
        "type": "object",
        "description": "One population a release states (`shape.Release.populations`).",
        "required": [
          "name",
          "definition",
          "ref_day"
        ],
        "properties": {
          "definition": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "ref_day": {
            "type": [
              "string",
              "null"
            ],
            "description": "The ISO day the population is stated for."
          }
        }
      },
      "ProjectBinding": {
        "type": "object",
        "description": "One variable to extract.",
        "required": [
          "variable",
          "type"
        ],
        "properties": {
          "classification": {
            "type": [
              "string",
              "null"
            ],
            "description": "A classification version's public id `class/<family>/<version>`.",
            "pattern": "^class/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$"
          },
          "date_format": {
            "type": [
              "string",
              "null"
            ]
          },
          "datetime_format": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "id_subtype": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProjectIdSubtype"
              },
              {
                "type": "null"
              }
            ]
          },
          "numeric_subtype": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProjectNumericSubtype"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "$ref": "#/components/schemas/ProjectColumnType"
          },
          "variable": {
            "type": "string",
            "description": "The binding FQID `<provider>/<register>/<slug>`."
          }
        },
        "additionalProperties": false
      },
      "ProjectColumnType": {
        "type": "string",
        "enum": [
          "id",
          "categorical",
          "numeric",
          "date",
          "datetime",
          "opaque"
        ]
      },
      "ProjectData": {
        "type": "object",
        "description": "The top-level `project_data.json` document.",
        "required": [
          "schema_version",
          "reg_meta_version",
          "name",
          "sources"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "panels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectPanel"
            }
          },
          "reg_meta_version": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSource"
            }
          },
          "window": {
            "$ref": "#/components/schemas/ProjectStudyWindow"
          }
        },
        "additionalProperties": false
      },
      "ProjectEdition": {
        "type": "string",
        "enum": [
          "final",
          "unstated",
          "preliminary"
        ]
      },
      "ProjectIdSubtype": {
        "type": "string",
        "enum": [
          "integer",
          "string"
        ]
      },
      "ProjectNumericSubtype": {
        "type": "string",
        "enum": [
          "integer",
          "double"
        ]
      },
      "ProjectPanel": {
        "type": "object",
        "description": "A panel over sources.",
        "required": [
          "panel_id",
          "members"
        ],
        "properties": {
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Source names."
          },
          "panel_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ProjectPeriodRange": {
        "type": "object",
        "description": "The `{\"from\": ..., \"to\": ...}` range.",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "$ref": "#/components/schemas/ProjectPeriodValue"
          },
          "to": {
            "$ref": "#/components/schemas/ProjectPeriodValue"
          }
        },
        "additionalProperties": false
      },
      "ProjectPeriodSegment": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ProjectPeriodValue"
          },
          {
            "$ref": "#/components/schemas/ProjectPeriodRange"
          }
        ],
        "description": "One contiguous piece of a source period."
      },
      "ProjectPeriodValue": {
        "oneOf": [
          {
            "type": "integer",
            "format": "int64"
          },
          {
            "type": "string"
          }
        ],
        "description": "A period endpoint as written: an int year or a period-token string (`\"_default\"`\nincluded, which only a scalar source period may hold)."
      },
      "ProjectSource": {
        "type": "object",
        "description": "One logical extraction: a table, a requested period and its bindings.",
        "required": [
          "name",
          "table",
          "period",
          "bindings"
        ],
        "properties": {
          "bindings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectBinding"
            }
          },
          "edition": {
            "$ref": "#/components/schemas/ProjectEdition",
            "description": "The release of the table asked for; absent asks for the primary edition."
          },
          "name": {
            "type": "string"
          },
          "period": {
            "$ref": "#/components/schemas/ProjectSourcePeriod"
          },
          "qualifier": {
            "type": "string",
            "description": "The delivery qualifier asked for; absent asks for every qualifier."
          },
          "table": {
            "type": "string",
            "description": "A table's public id: `<provider>/<register>` for a register's implicit table,\nelse `<provider>/<register>/<table>`."
          }
        },
        "additionalProperties": false
      },
      "ProjectSourcePeriod": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectPeriodSegment"
            }
          },
          {
            "$ref": "#/components/schemas/ProjectPeriodSegment"
          }
        ],
        "description": "`Source.period`: one segment, or a sorted, disjoint list of them (an interrupted\nseries)."
      },
      "ProjectStudyWindow": {
        "type": "object",
        "description": "The optional study window, in plain int years.",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "format": "int64"
          },
          "to": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "Release": {
        "type": "object",
        "description": "`shape.Release`: a delivery of a table.",
        "required": [
          "name",
          "period",
          "edition",
          "qualifier",
          "primary",
          "parse_state",
          "populations"
        ],
        "properties": {
          "edition": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parse_state": {
            "type": "string"
          },
          "period": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Period",
                "description": "`null` when the release is unparsed."
              },
              {
                "type": "null"
              }
            ]
          },
          "populations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Population"
            }
          },
          "primary": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "`null` when the release is unparsed."
          },
          "qualifier": {
            "type": "string"
          }
        }
      },
      "Segment": {
        "type": "object",
        "description": "`shape.Segment`.",
        "required": [
          "table",
          "period",
          "spelling",
          "type",
          "length",
          "format",
          "value_set",
          "classification",
          "coded",
          "sensitive",
          "identifier",
          "id_kind",
          "role",
          "temporality",
          "state"
        ],
        "properties": {
          "classification": {
            "type": [
              "string",
              "null"
            ],
            "description": "A classification version's ref."
          },
          "coded": {
            "type": "string"
          },
          "evidence": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Occurrence"
            },
            "description": "Present only when `evidence` is asked for."
          },
          "format": {
            "type": [
              "string",
              "null"
            ]
          },
          "id_kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "identifier": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "length": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "period": {
            "$ref": "#/components/schemas/Period"
          },
          "role": {
            "type": "string"
          },
          "sensitive": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "spelling": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "table": {
            "type": "string",
            "description": "The table's fqid."
          },
          "temporality": {
            "type": "string"
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "value_set": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ValueSetRef",
                "description": "`null` when the segment has no value set."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SegmentPage": {
        "type": "object",
        "description": "`Page<Segment>`.",
        "required": [
          "items",
          "next_cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Segment"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Sizes": {
        "type": "object",
        "description": "Every provider, register, table (implicit ones included) and variable.",
        "required": [
          "providers",
          "registers",
          "tables",
          "variables"
        ],
        "properties": {
          "providers": {
            "type": "integer",
            "format": "int64"
          },
          "registers": {
            "type": "integer",
            "format": "int64"
          },
          "tables": {
            "type": "integer",
            "format": "int64"
          },
          "variables": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ValueItem": {
        "type": "object",
        "description": "`shape.ValueItem`.",
        "required": [
          "code",
          "label",
          "level",
          "parent",
          "sentinel",
          "child_count"
        ],
        "properties": {
          "child_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "`null` for a flat set."
          },
          "code": {
            "type": "string",
            "description": "May be `\"\"`: a real item."
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "level": {
            "type": "integer",
            "format": "int64"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "description": "The parent's code."
          },
          "sentinel": {
            "type": "boolean"
          }
        }
      },
      "ValueItemsPage": {
        "type": "object",
        "description": "`Page<ValueItem>` plus the value set and `total`.",
        "required": [
          "items",
          "next_cursor",
          "value_set",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValueItem"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "type": "integer",
