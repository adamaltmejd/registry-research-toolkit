{
  "openapi": "3.1.0",
  "info": {
    "title": "reg-meta",
    "version": "0"
  },
  "paths": {
    "/api/context": {
      "get": {
        "description": "The catalog's identity and headline counts, for the SPA.",
        "operationId": "context",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Context"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error in `api/errors.toml`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/findings/{ref}": {
      "get": {
        "description": "The review items and notices on a register, a table or a variable (its segments and occurrences included), optionally narrowed to a period, a table or a rule code.",
        "operationId": "findings",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "table",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Finding"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error in `api/errors.toml`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/graph/{ref}": {
      "get": {
        "description": "The relations around a variable, a table or a register: what it continues or is continued by, what it is derived from, with the day a succession starts and the source's own words about it. `kind=derived_from` is the lineage.",
        "operationId": "graph",
        "parameters": [
          {
            "name": "ref",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "continues",
                "equivalent",
                "derived_from",
                "label_of"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Graph"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error in `api/errors.toml`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "meta"
                  ],
                  "properties": {
                    "error": {
                      "$ref": "#/components/schemas/Error"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Context": {
        "type": "object",
        "description": "`shape.Context`.",
        "required": [
          "catalog_version",
          "schema_version",
          "period_span",
          "reg_meta_version",
          "sizes"
        ],
        "properties": {
          "catalog_version": {
            "type": "string"
          },
          "period_span": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Period",
                "description": "The hull of every register; `null` for a catalog without registers."
              },
              {
                "type": "null"
              }
            ]
          },
          "reg_meta_version": {
            "type": "string",
            "description": "The server's version, which seeds a new project's `reg_meta_version`."
          },
          "schema_version": {
            "type": "string"
          },
          "sizes": {
            "$ref": "#/components/schemas/Sizes"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "The error document `{code, class, message, remediation, fields}`.",
        "required": [
          "code",
          "class",
          "message",
          "remediation",
          "fields"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "fields": {
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        }
      },
      "Finding": {
        "type": "object",
        "description": "`shape.Finding`.",
        "required": [
          "code",
          "severity",
          "subject",
          "period",
          "message",
          "caveat"
        ],
        "properties": {
          "caveat": {
            "type": [
              "string",
              "null"
            ],
            "description": "An acked statement's caveat."
          },
          "code": {
            "type": "string",
            "description": "A rule code and its sub-kind, `F7:edition-disagreement`."
          },
          "message": {
            "type": "string"
          },
          "period": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Period"
              },
              {
                "type": "null"
              }
            ]
          },
          "severity": {
            "type": "string",
            "description": "`review` or `notice`."
          },
          "subject": {
            "$ref": "#/components/schemas/Subject"
          }
        }
      },
      "Graph": {
        "type": "object",
        "description": "`shape.Graph`: the focus, its nodes and the relations between them.",
        "required": [
          "focus",
          "nodes",
          "edges"
        ],
        "properties": {
          "edges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphEdge"
            }
          },
          "focus": {
            "type": "string",
            "description": "The ref's fqid."
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphNode"
            }
          }
        }
      },
      "GraphEdge": {
        "type": "object",
        "required": [
          "kind",
          "from",
          "to",
          "at",
          "prov",
          "caveat"
        ],
        "properties": {
          "at": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Period",
                "description": "From the day a succession takes over; `null` when the source states no day."
              },
              {
                "type": "null"
              }
            ]
          },
          "caveat": {
            "type": [
              "string",
              "null"
            ],
            "description": "The source's own words about the relation."
          },
          "from": {
            "type": "string",
            "description": "The subject's fqid."
          },
          "kind": {
            "type": "string",
            "description": "`continues`, `equivalent`, `derived_from` or `label_of`."
          },
          "prov": {
            "type": "string",
            "description": "`source`, `curated` or `rule`."
          },
          "to": {
            "type": "string",
            "description": "The object's fqid."
          }
        }
      },
      "GraphNode": {
        "type": "object",
        "required": [
          "fqid",
          "kind",
          "name"
        ],
        "properties": {
          "fqid": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "description": "`variable`, `table`, `register` or `class_version`."
          },
          "name": {
            "type": "string",
            "description": "A register's or table's name, a variable's or class version's label."
          }
        }
      },
      "Meta": {
        "type": "object",
        "description": "The response `meta` (`shape.Meta`).",
        "required": [
          "contract_version",
          "generation",
          "catalog_version"
        ],
        "properties": {
          "catalog_version": {
            "type": "string"
          },
          "contract_version": {
            "type": "string"
          },
          "generation": {
            "type": "string"
          }
        }
      },
      "Period": {
        "type": "object",
        "description": "`shape.Period`: a half-open `[start, end)` of ISO days, `null` for an open end.",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "end": {
            "type": [
              "string",
              "null"
            ]
          },
          "start": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ProjectBinding": {
        "type": "object",
        "description": "One variable to extract.",
        "required": [
          "variable",
          "type"
        ],
        "properties": {
          "classification": {
            "type": [
              "string",
              "null"
            ],
            "description": "A classification version's public id `class/<family>/<version>`.",
            "pattern": "^class/[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$"
          },
          "date_format": {
            "type": [
              "string",
              "null"
            ]
          },
          "datetime_format": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "id_subtype": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProjectIdSubtype"
              },
              {
                "type": "null"
              }
            ]
          },
          "numeric_subtype": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProjectNumericSubtype"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "$ref": "#/components/schemas/ProjectColumnType"
          },
          "variable": {
            "type": "string",
            "description": "The binding FQID `<provider>/<register>/<slug>`."
          }
        },
        "additionalProperties": false
      },
      "ProjectColumnType": {
        "type": "string",
        "enum": [
          "id",
          "categorical",
          "numeric",
          "date",
          "datetime",
          "opaque"
        ]
      },
      "ProjectData": {
        "type": "object",
        "description": "The top-level `project_data.json` document.",
        "required": [
          "schema_version",
          "reg_meta_version",
          "name",
          "sources"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "panels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectPanel"
            }
          },
          "reg_meta_version": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectSource"
            }
          },
          "window": {
            "$ref": "#/components/schemas/ProjectStudyWindow"
          }
        },
        "additionalProperties": false
      },
      "ProjectEdition": {
        "type": "string",
        "enum": [
          "final",
          "unstated",
          "preliminary"
        ]
      },
      "ProjectIdSubtype": {
        "type": "string",
        "enum": [
          "integer",
          "string"
        ]
      },
      "ProjectNumericSubtype": {
        "type": "string",
        "enum": [
          "integer",
          "double"
        ]
      },
      "ProjectPanel": {
        "type": "object",
        "description": "A panel over sources.",
        "required": [
          "panel_id",
          "members"
        ],
        "properties": {
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Source names."
          },
          "panel_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ProjectPeriodRange": {
        "type": "object",
        "description": "The `{\"from\": ..., \"to\": ...}` range.",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "$ref": "#/components/schemas/ProjectPeriodValue"
          },
          "to": {
            "$ref": "#/components/schemas/ProjectPeriodValue"
          }
        },
        "additionalProperties": false
      },
      "ProjectPeriodSegment": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ProjectPeriodValue"
          },
          {
            "$ref": "#/components/schemas/ProjectPeriodRange"
          }
        ],
        "description": "One contiguous piece of a source period."
      },
      "ProjectPeriodValue": {
        "oneOf": [
          {
            "type": "integer",
            "format": "int64"
          },
          {
            "type": "string"
          }
        ],
        "description": "A period endpoint as written: an int year or a period-token string (`\"_default\"`\nincluded, which only a scalar source period may hold)."
      },
      "ProjectSource": {
        "type": "object",
        "description": "One logical extraction: a table, a requested period and its bindings.",
        "required": [
          "name",
          "table",
          "period",
          "bindings"
        ],
        "properties": {
          "bindings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectBinding"
            }
          },
          "edition": {
            "$ref": "#/components/schemas/ProjectEdition",
            "description": "The release of the table asked for; absent asks for the primary edition."
          },
          "name": {
            "type": "string"
          },
          "period": {
            "$ref": "#/components/schemas/ProjectSourcePeriod"
          },
          "qualifier": {
            "type": "string",
            "description": "The delivery qualifier asked for; absent asks for every qualifier."
          },
          "table": {
            "type": "string",
            "description": "A table's public id: `<provider>/<register>` for a register's implicit table,\nelse `<provider>/<register>/<table>`."
          }
        },
        "additionalProperties": false
      },
      "ProjectSourcePeriod": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectPeriodSegment"
            }
          },
          {
            "$ref": "#/components/schemas/ProjectPeriodSegment"
          }
        ],
        "description": "`Source.period`: one segment, or a sorted, disjoint list of them (an interrupted\nseries)."
      },
      "ProjectStudyWindow": {
        "type": "object",
        "description": "The optional study window, in plain int years.",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "format": "int64"
          },
          "to": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "Sizes": {
        "type": "object",
        "description": "Every provider, register, table (implicit ones included) and variable.",
        "required": [
          "providers",
          "registers",
          "tables",
          "variables"
        ],
        "properties": {
          "providers": {
            "type": "integer",
            "format": "int64"
          },
          "registers": {
            "type": "integer",
            "format": "int64"
          },
          "tables": {
            "type": "integer",
            "format": "int64"
          },
          "variables": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Subject": {
        "type": "object",
        "description": "`shape.Subject`: what a finding is about, by natural key.",
        "required": [
          "kind",
          "fqid",
          "table",
          "period",
          "release",
          "spelling",
          "value_set"
        ],
        "properties": {
          "fqid": {
            "type": [
              "string",
              "null"
            ],
            "description": "The register, table or variable; for a segment or an occurrence, its variable."
          },
          "kind": {
            "type": "string",
            "description": "`register`, `table`, `release`, `variable`, `segment`, `occurrence` or\n`valueset`."
          },
          "period": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Period",
                "description": "The release's, segment's or occurrence's period; `null` when unplaced."
              },
              {
                "type": "null"
              }
            ]
          },
          "release": {
            "type": [
              "string",
              "null"
            ],
            "description": "A release's literal delivery name."
          },
          "spelling": {
            "type": [
              "string",
              "null"
            ],
            "description": "An occurrence's exact spelling."
          },
          "table": {
            "type": [
              "string",
              "null"
            ],
            "description": "The table of a release, segment or occurrence."
          },
          "value_set": {
            "type": [
              "string",
              "null"
            ],
            "description": "A value set's hash."
          }
        }
      }
    }
  }
}
