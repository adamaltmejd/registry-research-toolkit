# Project-local Codex execution policy.
#
# These rules are intentionally narrower than "allow the tool": they cover low-risk
# coordination commands repeatedly used by this project. A matching allow only removes
# the sandbox-escalation prompt; it does not authorize work outside the user's requested
# task or override AGENTS.md.

prefix_rule(
    pattern = ["gh", "pr", ["view", "list", "checks", "diff"]],
    decision = "allow",
    justification = "Read pull-request metadata, diffs, and CI state.",
    match = [
        "gh pr view 1140 --json headRefOid,isDraft",
        "gh pr list --state open --json number,title",
        "gh pr checks 1140 --watch",
        "gh pr diff 1140",
    ],
    not_match = [
        "gh pr create --draft",
        "gh pr merge 1140",
        "gh pr ready 1140",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "ready"],
    decision = "allow",
    justification = "Publish a converged pipeline PR for review without merging it.",
    match = ["gh pr ready 1140"],
    not_match = ["gh pr merge 1140"],
)

prefix_rule(
    pattern = ["gh", "issue", "list"],
    decision = "allow",
    justification = "Run the required open-and-closed issue deduplication search.",
    match = ["gh issue list --state all --search approvals"],
    not_match = [
        "gh issue create --title test",
        "gh issue edit 1140 --add-label bug",
    ],
)

# Git metadata is outside a linked worktree's writable root. Staging is a normal
# implementation step. Commits and pushes remain auto-reviewed: prefix rules cannot
# reliably reject a dangerous option that Git accepts at multiple argument positions.
prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Stage an explicitly selected implementation diff in this trusted repository.",
    match = [
        "git add .codex/config.toml .codex/rules/development.rules",
        "git add -u",
    ],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["git", "pull", "--ff-only"],
    decision = "allow",
    justification = "Apply the canonical checkout's required fast-forward-only sync.",
    match = [
        "git pull --ff-only",
        "git pull --ff-only origin main",
    ],
    not_match = [
        "git pull --rebase origin main",
        "git reset --hard origin/main",
    ],
)

# Common high-impact command forms retain an explicit approval boundary. AGENTS.md and
# auto-review remain the load-bearing policy because command options may be reordered.
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "A hard reset can destroy uncommitted work.",
    match = ["git reset --hard origin/main"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Git clean can delete untracked user files.",
    match = ["git clean -fd"],
)

prefix_rule(
    pattern = ["git", "worktree", "remove"],
    decision = "prompt",
    justification = "Removing a worktree can discard local state.",
    match = ["git worktree remove /tmp/review-worktree"],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "prompt",
    justification = "Only chief-of-staff may merge after rechecking the durable gate.",
    match = ["gh pr merge 1140 --squash"],
)

prefix_rule(
    pattern = [["kill", "pkill", "killall"]],
    decision = "prompt",
    justification = "Process termination may affect unrelated development sessions.",
    match = [
        "kill 1234",
        "pkill -f chrome-devtools-mcp",
        "killall node",
    ],
)
