# Project-local Codex execution policy.
#
# These rules are intentionally narrower than "allow the tool": they cover low-risk
# coordination commands repeatedly used by this project. A matching allow only removes
# the sandbox-escalation prompt; it does not authorize work outside the user's requested
# task or override AGENTS.md.

prefix_rule(
    pattern = ["gh", "pr"],
    decision = "prompt",
    justification = "PR subcommands mutate remote state or accept --web to launch a host browser.",
    match = [
        "gh pr view 1140 --json headRefOid,isDraft",
        "gh pr merge 1140",
        "gh pr view 1140 --web",
    ],
    not_match = ["gh issue list --state all"],
)

prefix_rule(
    pattern = ["gh", "issue"],
    decision = "prompt",
    justification = "Issue subcommands mutate remote state or accept --web to launch a host browser.",
    match = [
        "gh issue list --state all --search approvals",
        "gh issue list --web",
    ],
    not_match = ["gh pr view 1140"],
)

# Git metadata is outside a linked worktree's writable root. Staging is a normal
# implementation step. Commits and pushes always prompt, so option reordering cannot
# hide a hook bypass or force push behind a broader user-level allow.
prefix_rule(
    pattern = ["git", "add"],
    decision = "prompt",
    justification = "Git add can launch configured editor or interactive diff helpers.",
    match = [
        "git add .codex/config.toml .codex/rules/development.rules",
        "git add --edit",
        "git add --patch",
    ],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["git", "pull"],
    decision = "prompt",
    justification = "Git pull accepts transport options that can execute host commands.",
    match = [
        "git pull --ff-only",
        "git pull --ff-only origin main",
        "git pull --ff-only --upload-pack=malicious /tmp/repo HEAD",
    ],
    not_match = ["git status --short"],
)

# Match the whole subcommand, not a particular option position.
prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Commits must run hooks and include only the intended staged diff.",
    match = [
        "git commit -m normal",
        "git commit -m bypass --no-verify",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Remote publication, hook bypasses, and branch rewriting require review.",
    match = [
        "git push origin branch",
        "git push origin branch --force-with-lease",
    ],
)

# Common high-impact command forms retain an explicit approval boundary.
prefix_rule(
    pattern = ["git", "reset"],
    decision = "prompt",
    justification = "Git reset can destroy staged or working-tree changes.",
    match = [
        "git reset --hard origin/main",
        "git reset -q --hard origin/main",
    ],
    not_match = ["git status --short"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Git clean can delete untracked user files.",
    match = ["git clean -fd"],
)

prefix_rule(
    pattern = ["git", "worktree", "remove"],
    decision = "prompt",
    justification = "Removing a worktree can discard local state.",
    match = ["git worktree remove /tmp/review-worktree"],
)

prefix_rule(
    pattern = [["kill", "pkill", "killall"]],
    decision = "prompt",
    justification = "Process termination may affect unrelated development sessions.",
    match = [
        "kill 1234",
        "pkill -f chrome-devtools-mcp",
        "killall node",
    ],
)
