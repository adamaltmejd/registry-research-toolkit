# Project-local Codex execution policy.
#
# These rules are intentionally narrower than "allow the tool": they cover the pinned
# verification commands and repository workflows repeatedly used by this project. A
# matching allow only removes the sandbox-escalation prompt; it does not authorize work
# outside the user's requested task or override AGENTS.md.

prefix_rule(
    pattern = ["uvx", "--from", "ty==0.0.54", "ty", "check"],
    decision = "allow",
    justification = "Run the repository-pinned read-only Python type checker.",
    match = [
        "uvx --from ty==0.0.54 ty check",
        "uvx --from ty==0.0.54 ty check reg_meta",
    ],
    not_match = ["uvx --from ty ty check"],
)

prefix_rule(
    pattern = ["uvx", "--from", "panache-cli==2.59.0", "panache"],
    decision = "allow",
    justification = "Run the repository-pinned Markdown formatter and linter.",
    match = [
        "uvx --from panache-cli==2.59.0 panache format --check .",
        "uvx --from panache-cli==2.59.0 panache lint --check .",
    ],
    not_match = ["uvx --from panache-cli panache lint --check ."],
)

prefix_rule(
    pattern = ["uv", "run", "ruff", ["check", "format"]],
    decision = "allow",
    justification = "Run the workspace-configured Python lint and format commands.",
    match = [
        "uv run ruff check",
        "uv run ruff format --check",
        "uv run ruff format reg_meta/src/reg_meta/queries.py",
    ],
    not_match = ["uv run ruff server"],
)

prefix_rule(
    pattern = ["uv", "run", "python", "-m", "pytest"],
    decision = "allow",
    justification = "Run repository tests, including localhost smoke-test fixtures.",
    match = [
        "uv run python -m pytest",
        "uv run python -m pytest reg_meta/ -q",
    ],
    not_match = ["uv run python scripts/release.py"],
)

prefix_rule(
    pattern = ["bun", "run", ["lint", "check", "test", "build"]],
    decision = "allow",
    justification = "Run the frontend's declared verification scripts and browser tests.",
    match = [
        "bun run lint",
        "bun run check",
        "bun run test",
        "bun run build",
        "bun run test -- SearchView.browser.test.ts",
    ],
    not_match = [
        "bun run dev",
        "bun /tmp/search_perf_trace.mjs",
    ],
)

prefix_rule(
    pattern = ["bash", "reg_webapp/.claude/skills/run-reg-webapp/dev.sh", ["preview", "smoke", "shot"]],
    decision = "allow",
    justification = "Run the repository-owned local webapp driver for render verification.",
    match = [
        "bash reg_webapp/.claude/skills/run-reg-webapp/dev.sh preview",
        "bash reg_webapp/.claude/skills/run-reg-webapp/dev.sh smoke",
        "bash reg_webapp/.claude/skills/run-reg-webapp/dev.sh shot /search?q=person",
    ],
    not_match = [
        "bash /tmp/dev.sh preview",
        "bash reg_webapp/.claude/skills/run-reg-webapp/dev.sh deploy",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", ["view", "list", "checks", "diff"]],
    decision = "allow",
    justification = "Read pull-request metadata, diffs, and CI state.",
    match = [
        "gh pr view 1140 --json headRefOid,isDraft",
        "gh pr list --state open --json number,title",
        "gh pr checks 1140 --watch",
        "gh pr diff 1140",
    ],
    not_match = [
        "gh pr create --draft",
        "gh pr merge 1140",
        "gh pr ready 1140",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "create", "--draft"],
    decision = "allow",
    justification = "Open the draft PR claim required by an explicitly invoked PR pipeline.",
    match = ["gh pr create --draft --base main --title wip --body-file /tmp/body.md"],
    not_match = [
        "gh pr create --base main --title ready",
        "gh pr merge 1140",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "ready"],
    decision = "allow",
    justification = "Publish a converged pipeline PR for review without merging it.",
    match = ["gh pr ready 1140"],
    not_match = ["gh pr merge 1140"],
)

prefix_rule(
    pattern = ["gh", "issue", "list"],
    decision = "allow",
    justification = "Run the required open-and-closed issue deduplication search.",
    match = ["gh issue list --state all --search approvals"],
    not_match = [
        "gh issue create --title test",
        "gh issue edit 1140 --add-label bug",
    ],
)

prefix_rule(
    pattern = [
        "uv",
        "run",
        "--no-project",
        "python",
        [
            "scripts/gh_issue.py",
            "scripts/cos_preflight.py",
            "scripts/check_issue_hygiene.py",
            "scripts/plan_sequence.py",
            "scripts/cos_watch.py",
        ],
    ],
    decision = "allow",
    justification = "Run the repository-owned trusted issue and coordination workflows.",
    match = [
        "uv run --no-project python scripts/gh_issue.py view 1140 --comments",
        "uv run --no-project python scripts/cos_preflight.py",
        "uv run --no-project python scripts/cos_preflight.py --commit fingerprint",
        "uv run --no-project python scripts/check_issue_hygiene.py",
        "uv run --no-project python scripts/plan_sequence.py --tick 328",
        "uv run --no-project python scripts/cos_watch.py --once",
    ],
    not_match = [
        "uv run --no-project python scripts/cos_dispatch.py --auto",
        "uv run --no-project python scripts/codex_local_review.py --base origin/main",
    ],
)

# Git metadata is outside a linked worktree's writable root. Staging is a normal
# implementation step, but commits remain auto-reviewed so hook bypass flags cannot be
# hidden later in the argument list. Network publication, branch rewriting, worktree
# removal, and merges also remain outside the allow list.
prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Stage an explicitly selected implementation diff in this trusted repository.",
    match = [
        "git add .codex/config.toml .codex/rules/development.rules",
        "git add -u",
    ],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["git", "pull", "--ff-only"],
    decision = "allow",
    justification = "Apply the canonical checkout's required fast-forward-only sync.",
    match = [
        "git pull --ff-only",
        "git pull --ff-only origin main",
    ],
    not_match = [
        "git pull --rebase origin main",
        "git reset --hard origin/main",
    ],
)

# Load-bearing repository prohibitions. These are blocked even if a broader user rule
# exists; use the hook-enabled form instead.
prefix_rule(
    pattern = ["git", "commit", ["--no-verify", "-n"]],
    decision = "forbidden",
    justification = "Repository policy requires commit hooks; remove --no-verify/-n.",
    match = [
        "git commit --no-verify -m bypass",
        "git commit -n -m bypass",
    ],
    not_match = ["git commit -m normal"],
)

prefix_rule(
    pattern = ["git", "push", ["--no-verify", "-n"]],
    decision = "forbidden",
    justification = "Repository policy requires push hooks; remove --no-verify/-n.",
    match = [
        "git push --no-verify origin branch",
        "git push -n origin branch",
    ],
    not_match = ["git push origin branch"],
)

# High-impact operations always retain an explicit approval boundary. These prompt
# rules also override a less-specific allow rule from another active config layer.
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "A hard reset can destroy uncommitted work.",
    match = ["git reset --hard origin/main"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Git clean can delete untracked user files.",
    match = ["git clean -fd"],
)

prefix_rule(
    pattern = ["git", "worktree", "remove"],
    decision = "prompt",
    justification = "Removing a worktree can discard local state.",
    match = ["git worktree remove /tmp/review-worktree"],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "--force-with-lease"]],
    decision = "prompt",
    justification = "Rewriting a remote branch requires current-head verification.",
    match = [
        "git push --force origin branch",
        "git push --force-with-lease origin branch",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "prompt",
    justification = "Only chief-of-staff may merge after rechecking the durable gate.",
    match = ["gh pr merge 1140 --squash"],
)

prefix_rule(
    pattern = [["kill", "pkill", "killall"]],
    decision = "prompt",
    justification = "Process termination may affect unrelated development sessions.",
    match = [
        "kill 1234",
        "pkill -f chrome-devtools-mcp",
        "killall node",
    ],
)
