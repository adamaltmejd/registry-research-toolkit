# Project-local Codex execution policy.
#
# These broad prompt rules guard shell commands whose trailing options can launch host
# helpers, execute transports, or mutate remote/destructive state. They do not authorize
# work outside the user's requested task or override AGENTS.md.

prefix_rule(
    pattern = ["gh", "pr"],
    decision = "prompt",
    justification = "PR subcommands mutate remote state or accept --web to launch a host browser.",
    match = [
        "gh pr view 1140 --json headRefOid,isDraft",
        "gh pr merge 1140",
        "gh pr view 1140 --web",
    ],
    not_match = ["gh issue list --state all"],
)

prefix_rule(
    pattern = ["gh", "issue"],
    decision = "prompt",
    justification = "Issue subcommands mutate remote state or accept --web to launch a host browser.",
    match = [
        "gh issue list --state all --search approvals",
        "gh issue list --web",
    ],
    not_match = ["gh pr view 1140"],
)

# Git accepts global options before its subcommand, including config and repository-path
# overrides. Match the executable itself so no option ordering can bypass the boundary.
prefix_rule(
    pattern = ["git"],
    decision = "prompt",
    justification = "Git global and subcommand options can invoke helpers or mutate repository state.",
    match = [
        "git status --short",
        "git commit -m normal",
        "git -C . commit -m normal",
        "git -c core.hooksPath=/dev/null commit -m bypass",
        "git --git-dir=.git reset --hard HEAD",
    ],
    not_match = ["gh pr view 1140"],
)

# Common command launchers can otherwise hide Git from the direct executable rule.
# Match each launcher broadly because its own options and environment assignments can
# precede the wrapped command.
prefix_rule(
    pattern = [["env", "/usr/bin/env", "command", "xcrun"]],
    decision = "prompt",
    justification = "Command launchers can wrap Git or other host executables and bypass their direct rules.",
    match = [
        "env git commit -m normal",
        "env GIT_CONFIG_NOSYSTEM=1 git status --short",
        "command git reset --hard HEAD",
        "xcrun git commit -m normal",
    ],
    not_match = ["git status --short"],
)

prefix_rule(
    pattern = [["kill", "pkill", "killall"]],
    decision = "prompt",
    justification = "Process termination may affect unrelated development sessions.",
    match = [
        "kill 1234",
        "pkill -f chrome-devtools-mcp",
        "killall node",
    ],
)
