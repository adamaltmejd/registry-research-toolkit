        "register",
        "variable",
        "column",
        "name",
        "description"
      ],
      "rows": [
        [
          "condition",
          "invarn",
          "INVARN8",
          "Date8",
          "Description 8"
        ],
        [
          "condrev",
          "invarn",
          "INVARN8",
          "Date8",
          "Description 8"
        ],
        [
