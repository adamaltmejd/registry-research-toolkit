            "condconf.toml#/errata.field/3["
          ]
        }
      },
      "fields": [
        "fields"
      ],
      "match": "set",
      "rows": [
        [
          [
            "name"
          ]
        ]
      ],
      "note": "The two name entries of condconf conflict on the name field."
    },
    {
      "table": "issue_refs",
      "where": {
