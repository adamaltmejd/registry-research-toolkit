{
  "status": "diagnostic_complete",
  "projections": [
    {
      "table": "issues",
      "where": {"severity": "error"},
      "fields": ["subject", "code", "case_id", "fields"],
      "note": "Every error. units, texts and fixunit report none (the replaced tests assert no error). bare is the baseline: without an entry the two edition names conflict. overlap keeps its same-column unit conflict under a name permission. descriptions permits only descriptions, so its names still conflict and it forms no variable. coded's entry goes stale on the added list (stale_representation_coding at its entry, subject its native variable 6.6) and its names then conflict. fixname's checked name correction is not waived by the name permission.",
      "rows": [
        ["scb/overlap/income", "conflicting_occurrence_facts", null, ["measurement_unit"]],
        ["scb/bare/income", "conflicting_variable_fact", null, ["name"]],
        ["scb/bare/income", "unresolved_variable_name", null, ["name"]],
        ["scb/descriptions/income", "conflicting_variable_fact", null, ["name"]],
        ["scb/descriptions/income", "unresolved_variable_name", null, ["name"]],
        ["('scb-registerinformation', 'scb', 'register', 'native-int', 6, 'variable', 'native-int', 6)", "stale_representation_coding", "curation/registers/scb/coded.toml#/representation.delivery_metadata/1", ["coding"]],
        ["scb/coded/income", "conflicting_variable_fact", null, ["name"]],
        ["scb/coded/income", "unresolved_variable_name", null, ["name"]],
        ["scb/coded/income", "missing_coding_period", null, ["coding"]],
        ["scb/fixname/income", "conflicting_variable_fact", null, ["name"]],
        ["scb/fixname/income", "unresolved_variable_name", null, ["name"]]
      ]
    },
    {
      "table": "issues",
      "where": {"code": "stale_curation_entry"},
      "fields": ["subject", "case_id"],
      "note": "Every entry and both [[errata.field]] corrections compile against the reviewed rows.",
      "rows": []
    },
    {
      "table": "issues",
      "where": {"code": "delivery_units_vary"},
      "fields": ["subject"],
      "note": "Every variable delivered in two units warns, including fixname and fixunit (the replaced correction test); texts and descriptions deliver one unit.",
      "rows": [
        ["scb/units/income"],
        ["scb/bare/income"],
        ["scb/overlap/income"],
        ["scb/coded/income"],
        ["scb/fixname/income"],
        ["scb/fixunit/income"]
      ]
    },
    {
      "table": "states",
      "fields": ["register", "valid_from", "valid_to", "state_name", "measurement_unit", "description", "name"],
      "note": "Each state keeps its own edition's literal unit, name and description; no variable takes a common name. overlap writes no unit for the contested 2020 state. fixunit's corrected 2020 unit is written.",
      "rows": [
        ["units", "2020-01-01", "2020-12-31", "Income 2020", "100-tal kronor", null, null],
        ["units", "2021-01-01", "2021-12-31", "Income 2021", "Kronor (SEK)", null, null],
        ["overlap", "2020-01-01", "2020-12-31", "Income 2020", null, null, "Income 2020"],
        ["texts", "2020-01-01", "2020-12-31", "Visit", "Kronor (SEK)", "Visited facility", null],
        ["texts", "2021-01-01", "2021-12-31", "Admission", "Kronor (SEK)", "Admitting facility", null],
        ["fixunit", "2020-01-01", "2020-12-31", "Income 2020", "Checked source wording", null, null],
        ["fixunit", "2021-01-01", "2021-12-31", "Income 2021", "Kronor (SEK)", null, null]
      ]
    },
    {
      "table": "variables",
      "fields": ["register", "column", "description"],
      "note": "texts takes no common description from either edition.",
      "rows": [
        ["units", "VALUE", null],
        ["overlap", "VALUE", null],
        ["texts", "VALUE", null],
        ["fixunit", "VALUE", null]
      ]
    },
    {
      "table": "search_text",
      "where": {"register": "texts"},
      "fields": ["name", "definition", "description", "delivery_column_names"],
      "note": "texts has no common name or description, so the search index holds both editions' own names and descriptions, distinct and sorted, beside the shared definition and the delivery column.",
      "rows": [
        ["Admission\nVisit", "Source supplied income definition", "Admitting facility\nVisited facility", ["VALUE"]]
      ]
    },
    {
      "table": "registers",
      "fields": ["register", "name", "purpose"],
      "note": "Every delivered register is written with its Registernamn and Registersyfte (`Testning`, the `var_row` default), including bare, descriptions, coded and fixname, which form no variable in this diagnostic build.",
      "rows": [
        ["units", "UNITS", "Testning"],
        ["bare", "BARE", "Testning"],
        ["overlap", "OVERLAP", "Testning"],
        ["texts", "TEXTS", "Testning"],
        ["descriptions", "DESCRIPTIONS", "Testning"],
        ["coded", "CODED", "Testning"],
        ["fixname", "FIXNAME", "Testning"],
        ["fixunit", "FIXUNIT", "Testning"]
      ]
    },
    {
      "table": "variants",
      "fields": ["register", "variant", "name", "description", "display_group", "panel_entity_key", "panel_time_key", "panel_time_grain"],
      "note": "Every delivered variant is written with its Registervariantnamn and Registervariantbeskrivning (the `var_row` defaults `Individer` and `Alla individer`), also in the registers without a variable. units' [[variant]] declares a display group, a one-slug panel entity key list (written as a JSON list), a time key and a grain; the others declare none.",
      "rows": [
        ["units", "people", "Individer", "Alla individer", "Population tables", "[\"income\"]", "period", "delivery"],
        ["bare", "people", "Individer", "Alla individer", null, null, null, null],
        ["overlap", "people", "Individer", "Alla individer", null, null, null, null],
        ["texts", "people", "Individer", "Alla individer", null, null, null, null],
        ["descriptions", "people", "Individer", "Alla individer", null, null, null, null],
        ["coded", "people", "Individer", "Alla individer", null, null, null, null],
        ["fixname", "people", "Individer", "Alla individer", null, null, null, null],
        ["fixunit", "people", "Individer", "Alla individer", null, null, null, null]
      ]
    },
    {
      "table": "editions",
      "where": {"register": ["units", "bare"]},
      "fields": ["register", "variant", "name", "description", "measurement_information", "documentation_status", "first_approved_at", "last_approved_at", "populations", "object_types"],
      "note": "Each edition keeps its Registerversion prose, its population and its object type, all `var_row` defaults: `Version <year>`, `Godkänd`, approval dates on the year's bounds, `Hela befolkningen`/`Alla personer` dated `<year>-12-31`, `Person`/`Fysisk person`. A blank mätinformation and a blank population comment are written as null. bare forms no variable and still keeps both editions.",
      "rows": [
        ["units", "people", "2020", "Version 2020", null, "Godkänd", "2020-01-01", "2020-12-31", [["Hela befolkningen", "Alla personer", null, "2020-12-31"]], [["Person", "Fysisk person"]]],
        ["units", "people", "2021", "Version 2021", null, "Godkänd", "2021-01-01", "2021-12-31", [["Hela befolkningen", "Alla personer", null, "2021-12-31"]], [["Person", "Fysisk person"]]],
        ["bare", "people", "2020", "Version 2020", null, "Godkänd", "2020-01-01", "2020-12-31", [["Hela befolkningen", "Alla personer", null, "2020-12-31"]], [["Person", "Fysisk person"]]],
        ["bare", "people", "2021", "Version 2021", null, "Godkänd", "2021-01-01", "2021-12-31", [["Hela befolkningen", "Alla personer", null, "2021-12-31"]], [["Person", "Fysisk person"]]]
      ]
    },
    {
      "table": "states",
      "where": {"register": "units"},
      "fields": ["column", "valid_from", "data_length", "operational_definition", "provenance", "pooled"],
      "note": "Each state keeps its own row's Datalängd and operational definition (CVID 101: length 1, the `var_row` default; CVID 102: length 12). A state formed from the source alone has no provenance, and an annual edition is not pooled.",
      "rows": [
        ["VALUE", "2020-01-01", "1", "Income counted in 2020", null, 0],
        ["VALUE", "2021-01-01", "12", "Income counted in 2021", null, 0]
      ]
    }
  ]
}
