{
  "projections": [
    {
      "table": "issues",
      "fields": ["code"],
      "rows": []
    },
    {
      "table": "variables",
      "where": {"register": "sample"},
      "fields": ["variable", "column"],
      "match": "set",
      "rows": [
        ["first", "FIRST"],
        ["second", "SECOND"]
      ]
    },
    {
      "table": "uses",
      "where": {"source": "scb-registerinformation"},
      "fields": ["column_name", "key", "use", "variable"],
      "rows": [
        ["FIRST", "member:20", "catalog", "scb/sample/first"],
        ["SECOND", "member:20", "catalog", "scb/sample/second"]
      ]
    }
  ]
}
