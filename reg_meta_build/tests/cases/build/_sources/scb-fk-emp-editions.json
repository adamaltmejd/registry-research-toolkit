{
  "description": "SCB register 1 delivers VALUE. FK's thin register remote delivers AMOUNT, which declares classification EMP2007, and SCORE, which declares EMP2020. Books EMP 2000, EMP 2007 and EMP 2020 form one edition chain; EMP 2007's CSV gives its only code two labels; book NIL's CSV has a header and no rows.",
  "scb": {
    "registerinformation": [
      {"cvid": 1001, "var_id": 101, "colname": "VALUE"}
    ]
  },
  "files": {
    "Forsakringskassan/fk.toml": [
      "[[register]]",
      "key = \"remote\"",
      "name = \"Remote\"",
      "valid_from = \"2020-01-01\"",
      "valid_to = \"2020-12-31\"",
      "[[register.variable]]",
      "name = \"Amount\"",
      "column = \"AMOUNT\"",
      "data_type = \"int\"",
      "classification = \"EMP2007\"",
      "[[register.variable]]",
      "name = \"Score\"",
      "column = \"SCORE\"",
      "data_type = \"int\"",
      "classification = \"EMP2020\""
    ],
    "classifications/emp2000.csv": ["code,label", "1,First"],
    "classifications/emp2007.csv": ["code,label", "1,First", "1,Competing"],
    "classifications/emp2020.csv": ["code,label", "1,First"],
    "classifications/nil.csv": ["code,label"]
  }
}
