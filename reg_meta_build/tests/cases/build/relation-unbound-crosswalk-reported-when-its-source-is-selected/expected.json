{
  "projections": [
    {
      "table": "issues",
      "where": {
        "subject": "('sheet:Kodlista_CROSSWALK',)",
        "refs": {"contains": "Socialstyrelsen/Metadata Syntetiskt register (SYN)_webb.xlsx"}
      },
      "fields": ["code", "severity"],
      "rows": [
        ["unbound_source_relationship", "error"]
      ]
    },
    {
      "table": "evidence",
      "where": {
        "disposition": ["out_of_slice_relationship", "unbound_relationship", "retained_unattached"]
      },
      "fields": ["disposition"],
      "rows": [
        ["unbound_relationship"]
      ]
    }
  ]
}
