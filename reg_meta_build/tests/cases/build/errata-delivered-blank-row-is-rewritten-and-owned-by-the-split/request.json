{
  "replaces": [
    "test_curation_partition_delivered_boundary.py::test_delivered_blank_row_is_rewritten_and_owned_by_the_split"
  ],
  "note": "The 2021 member with a literal blank column becomes column A under `a`.",
  "sources": {
    "description": "Variable 5 delivers A (2020, CVID 20), B in variant 3 (2020, CVID 23) and a literal blank column in 2021 (CVID 22).",
    "scb": {
      "registerinformation": [
        {
          "colname": "A",
          "cvid": 20,
          "var_id": 5,
          "year": "2020",
          "regver_id": 2020,
          "register": ["TEST", 1, 2]
        },
        {
          "colname": "B",
          "cvid": 23,
          "var_id": 5,
          "year": "2020",
          "regver_id": 2020,
          "register": ["TEST", 1, 3]
        },
        {
          "colname": "\"\"",
          "cvid": 22,
          "var_id": 5,
          "year": "2021",
          "regver_id": 2021,
          "register": ["TEST", 1, 2]
        }
      ],
      "unika": [
        "TEST|Testregistret|Individer|Individer|GenericVar|A|2020|2020|0|0|0",
        "TEST|Testregistret|Individer|Individer|GenericVar|B|2020|2020|0|0|0"
      ]
    }
  }
}
