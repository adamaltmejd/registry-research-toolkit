{
  "projections": [
    {
      "table": "issues",
      "where": {"severity": "error"},
      "fields": ["code"],
      "rows": []
    },
    {
      "table": "variables",
      "fields": ["variable", "name", "source_name"],
      "rows": [
        ["efternamn", "Namn (EFTERNAMN)", "Namn"],
        ["fornamn", "Namn (FORNAMN)", "Namn"],
        ["hade-hsl-feb", "Hade HSL i månad (FEB)", "Hade HSL i månad"],
        ["hade-hsl-jan", "Hade HSL i månad (JAN)", "Hade HSL i månad"],
        ["hade-hsl-mar", "Hade HSL i månad (MAR)", "Hade HSL i månad"]
      ],
      "note": "Each pair shares its definition, so every member takes its own column; each keeps the source name it was formed under."
    },
    {
      "table": "group_labels",
      "fields": ["group_key", "label", "source"],
      "rows": [
        ["efternamn", "Namn", "edge"],
        ["hade-hsl", "Hade HSL i månad", "token"]
      ],
      "note": "Both groups are labelled by the source name their renamed members share."
    }
  ]
}
