      "rows": [
        ["value", "origin", "ORIG"],
        ["earlier", "earlier", "ERL"]
      ]
    },
    {
      "note": "Attribution keeps the literal source text beside the resolved register, on the variable and on its state (the delivered VariabelRegister_Källa).",
      "table": "variables",
      "where": {"register": "example", "variable": "value"},
      "fields": ["source_register_text"],
      "rows": [["Original register (ORIG) : People"]]
    },
    {
      "table": "states",
      "where": {"register": "example", "variable": "value"},
      "fields": ["source_register_text"],
      "rows": [["Original register (ORIG) : People"]]
    },
    {
      "table": "lineage",
      "fields": ["register", "variable", "variant", "source_register", "source_variable", "source_variant", "valid_from", "valid_to"],
      "rows": [
        ["example", "value", "people", "origin", "value", "people", "2000-01-01", "2000-12-31"],
