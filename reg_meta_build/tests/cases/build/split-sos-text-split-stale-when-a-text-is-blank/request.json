{
  "replaces": [
    "test_curation_split_sos_boundary.py::test_text_split_is_stale_unless_the_delivered_texts_match[name-blank-text]"
  ],
  "fails_if": "the SOS split check in `curation_compile` drops its blank-row guard (`None in values`), so a row with a blank name beside the declared First and Second rows no longer makes the split stale",
  "sources": {
    "description": "PAR_OV ATC rows of one source record key whose labels are First, Second and a blank.",
    "scb": {
      "registerinformation": [
        {
          "cvid": 1001,
          "var_id": 101,
          "colname": "VALUE"
        }
      ]
    },
    "sos": [
      {
        "abbrev": "PAR",
        "title": "Patientregistret",
        "description": "Ett syntetiskt SOS-register för testbygget.",
        "subsets": [
          {
            "name": "PAR_OV",
            "label": "PAR_OV",
            "description": "Första vyn",
            "data_from": 2001,
            "data_to": 2020
          }
        ],
        "variables": [
          {
            "name": "ATC",
            "deldatamangd": "PAR_OV",
            "label": "First",
            "description": "ATC",
            "data_from": 2001,
            "data_to": 2020
          },
          {
            "name": "ATC",
            "deldatamangd": "PAR_OV",
            "label": "Second",
            "description": "ATC",
            "data_from": 2001,
            "data_to": 2020
          },
          {
            "name": "ATC",
            "deldatamangd": "PAR_OV",
            "label": null,
            "description": "ATC",
            "data_from": 2001,
            "data_to": 2020
          }
        ]
      }
    ]
  },
  "note": "The delivered non-blank names equal the declared parts exactly, so only the blank third row can make the split stale; the declared-text-missing and undeclared-text-delivered cases hold the set comparison."
}
