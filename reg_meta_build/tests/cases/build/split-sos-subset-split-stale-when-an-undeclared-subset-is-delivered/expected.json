{
  "projections": [
    {
      "table": "issues",
      "where": {"severity": "error"},
      "fields": ["code"],
      "rows": [
        ["stale_curation_entry"],
        ["unresolved_catalog_identity"]
      ]
    },
    {
      "table": "issues",
      "where": {"severity": "error", "code": "stale_curation_entry"},
      "fields": ["locator"],
      "rows": [
        ["curation/registers/sos/par.toml#/identity.split/1"]
      ]
    },
    {
      "table": "states",
      "where": {"register": "par"},
      "fields": ["variable", "variant", "column", "data_type", "name"],
      "rows": []
    }
  ]
}
