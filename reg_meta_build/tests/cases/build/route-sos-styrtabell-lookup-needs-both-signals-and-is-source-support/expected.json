{
  "projections": [
    {
      "table": "issues",
      "where": {"code": "invalid_sos_lookup_signals"},
      "fields": ["subject", "severity"],
      "rows": [
        ["A", "error"],
        ["B", "error"]
      ]
    },
    {
      "table": "issue_refs",
      "where": {"code": "invalid_sos_lookup_signals"},
      "fields": ["source"],
      "match": "set",
      "rows": [
        ["Socialstyrelsen/Metadata Signaler (SYS)_webb.xlsx"]
      ]
    },
    {
      "table": "case_uses",
      "where": {"source": "Socialstyrelsen/Metadata Uppslag (SYL)_webb.xlsx", "use": "support"},
      "fields": ["case_id"],
      "rows": [
        ["existing-source-use:Socialstyrelsen/Metadata Uppslag (SYL)_webb.xlsx"],
        ["existing-source-use:Socialstyrelsen/Metadata Uppslag (SYL)_webb.xlsx"],
        ["existing-source-use:Socialstyrelsen/Metadata Uppslag (SYL)_webb.xlsx"]
      ]
    },
    {
      "table": "uses",
      "where": {"source": "Socialstyrelsen/Metadata Uppslag (SYL)_webb.xlsx", "use": "support"},
      "fields": ["use"],
      "rows": [
        ["support"],
        ["support"],
        ["support"]
      ]
    },
    {
      "table": "states",
      "where": {"register": "syl"},
      "fields": ["variable", "variant"],
      "rows": []
    },
    {
      "table": "registers",
      "where": {"register": "syl"},
      "fields": ["register", "name"],
      "note": "SYL publishes no variable, yet its register is written, named by its workbook title.",
      "rows": [
        ["syl", "Uppslag"]
      ]
    },
    {
      "table": "variants",
      "where": {"register": "syl"},
      "fields": ["variant", "name"],
      "note": "Both delivered subsets are written as variants, named by their Deldatamängder labels, though neither carries a state and an SOS subset has no edition.",
      "rows": [
        ["a", "Styrtabell A"],
        ["v", "V"]
      ]
    },
    {
      "table": "editions",
      "where": {"register": "syl"},
      "fields": ["variant", "name"],
      "rows": []
    }
  ]
}
