{
  "loader": "relations",
  "replaces": "test_relation_declaration_loading.py::TestDerivedFromLoad::test_parses_classification_edge",
  "fails_if": "load_relations misreads a derived_from edge's class/<slug> endpoints, swaps derived and source, or drops its note",
  "loads": {
    "derived_from": [
      {
        "derived": {
          "kind": "classification",
          "provider": null,
          "register": null,
          "variable": null,
          "classification": "ks87-p"
        },
        "source": {
          "kind": "classification",
          "provider": null,
          "register": null,
          "variable": null,
          "classification": "icd-9-ks87"
        },
        "note": "primary-care variant"
      }
    ]
  }
}
