{
  "loader": "curated_source",
  "args": {
    "file": "agency.toml",
    "provider": "agency"
  },
  "replaces": "test_curated_source_records.py::test_broken_actual_format_contracts_fail_without_silent_fallback[is_identifier = \"\"]",
  "fails_if": "read_curated_source reads a blank is_identifier as the omitted (false) default instead of refusing it",
  "error": {
    "code": "source_preparation_failed",
    "locator": "register.0.variable.0.is_identifier",
    "message_contains": [
      "invalid global curated TOML",
      "valid boolean"
    ]
  }
}
