{
  "loader": "curated_source",
  "match": "includes",
  "args": {
    "file": "agency.toml",
    "provider": "agency"
  },
  "replaces": "test_curated_source_records.py::test_raw_toml_values_and_exact_key_locations_are_retained",
  "fails_if": "read_curated_source normalizes a cell's raw value, deduplicates or keeps the padding of declared variant references, or drops a key's exact location from the record locator",
  "note": "The variants cell's raw_value is the fixture's TOML array `[\" x \", \"y\", \"y\"]` written as compact JSON, the form a delivered cell carries a non-string TOML value in: the padding and the duplicate survive in the cell while the variant references are trimmed. The name, column and data_type cells are the fixture's string values as written, in file order.",
  "loads": {
    "records": [
      {
        "$any": true
      },
      {
        "fields": {
          "definition": {
            "value": "  First\n  second",
            "raw_value": "  First\n  second  "
          }
        },
        "subject": {
          "variant_references": [
            {
              "native_id": "x"
            },
            {
              "native_id": "y"
            },
            {
              "native_id": "y"
            }
          ]
        },
        "locators": [
          {
            "physical_cells": [
              "register[0].variable[0].name",
              "register[0].variable[0].column",
              "register[0].variable[0].data_type",
              "register[0].variable[0].definition",
              "register[0].variable[0].variants"
            ]
          }
        ],
        "delivered_cells": [
          {
            "name": "name",
            "raw_value": "A variable",
            "raw_type": "str"
          },
          {
            "name": "column",
            "raw_value": "CODE",
            "raw_type": "str"
          },
          {
            "name": "data_type",
            "raw_value": "text",
            "raw_type": "str"
          },
          {
            "name": "definition",
            "raw_value": "  First\n  second  "
          },
          {
            "name": "variants",
            "raw_value": "[\" x \",\"y\",\"y\"]",
            "raw_type": "list"
          }
        ]
      }
    ]
  }
}
