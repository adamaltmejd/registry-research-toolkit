{
  "loader": "relations",
  "replaces": [
    "test_relation_declaration_loading.py::TestSameAsLoad::test_parses_variable_grain_edge",
    "test_relation_declaration_loading.py::TestSameAsLoad::test_note_is_optional",
    "test_relation_declaration_loading.py::TestSameAsLoad::test_parses_classification_grain_edge"
  ],
  "fails_if": "load_relations misreads a 3-segment same_as edge as another grain, drops or invents its note, or misreads a 2-segment classification same_as edge",
