        "grain": "variable_binding",
        "a_provider": "scb",
        "a_register": "lisa",
        "a_variable": "inkomst",
        "b_provider": "scb",
        "b_register": "rams",
        "b_variable": "inkomst",
        "note": "candidate:tier1"
      },
      {
        "note": null
      },
      {
        "grain": "classification",
        "a_provider": "scb",
        "a_register": "sun2000",
        "a_variable": null
      }
    ]
  }
}
