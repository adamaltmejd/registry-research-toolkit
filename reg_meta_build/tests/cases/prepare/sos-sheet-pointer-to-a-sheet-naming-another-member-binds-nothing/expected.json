{
  "reader": "sos_workbook",
  "replaces": "test_sos_code_lists.py::test_sheet_pointer_uses_exact_target_and_named_member_guard[Kodlista_Target-SIBLING-False-False]",
  "fails_if": "the SOS reader binds HDIA to a code sheet that names another member because HDIA's Länk kodverk points at it, or keeps that pointer as a classification declaration",
  "projections": [
    {
      "of": "records",
      "where": {
        "locators": [{"physical_record": "row:2"}],
        "subject": {"member": {"name": "HDIA"}}
      },
      "rows": [
        {
          "fields": {"classification_declared": null},
          "delivered_cells": {"$once": [{"name": "Länk kodverk", "raw_value": "Kodlista_Target"}]}
        }
      ]
    },
    {
      "of": "descriptors",
      "where": {"key": "sheet:Kodlista_Target"},
      "rows": [
        {
          "value": {
            "member_references": {"$lacks": ["HDIA"]},
            "member_hints": {"$lacks": [{"role": "variable_pointer"}]}
          }
        }
      ]
    }
  ]
}
