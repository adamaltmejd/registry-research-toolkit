      "rows": [
        {"locators": [{"physical_table": "Metadata - Variabel -nivå", "physical_record": "row:2"}], "subject": {"member": {"name": "HDIA"}}},
        {"locators": [{"physical_record": "row:3"}], "subject": {"member": {"name": "HDIA"}}},
        {"locators": [{"physical_record": "row:4"}], "subject": {"member": {"name": "HDIA"}}},
        {"locators": [{"physical_record": "row:5"}], "subject": {"member": {"name": "HDIA"}}},
