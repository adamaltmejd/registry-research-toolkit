{
  "reader": "sos_workbook",
  "replaces": [
    "test_sos_parser.py::test_variable_sheet_is_found_when_its_name_splits_the_token[Metadata - Variabel nivå]",
    "test_sos_parser.py::test_variable_sheet_is_found_when_its_name_splits_the_token[Metadata - Variabel-nivå]"
