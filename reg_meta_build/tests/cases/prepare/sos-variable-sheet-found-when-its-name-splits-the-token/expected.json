        {"locators": [{"physical_record": "row:7"}], "subject": {"member": {"name": "MALFORMED"}}},
        {"locators": [{"physical_record": "row:8"}], "subject": {"member": {"name": "UTAN_DEL"}}}
      ]
    }
  ]
