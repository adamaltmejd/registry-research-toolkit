  "fails_if": "the SCB value reader reads an undelivered code, label, version, level or validity date as a delivered empty one (or the reverse)",
  "projections": [
    {
      "of": "associations",
      "rows": [
        {
          "value": {
            "code": null,
            "label": null
          },
          "descriptor": {
            "version": null
          }
        },
        {
          "value": {
            "code": "",
            "label": ""
          },
          "descriptor": {
            "version": ""
          }
        }
      ]
    },
    {
      "of": "validity",
      "rows": [
        {
          "valid_from": null
        },
        {
          "valid_from": ""
        }
      ]
    }
  ]
}
